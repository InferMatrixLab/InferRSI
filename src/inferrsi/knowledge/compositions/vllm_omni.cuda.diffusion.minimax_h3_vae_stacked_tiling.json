  "metadata": {
    "kind": "knowledge",
    "title": "MiniMax-H3 stacked VAE tiling trades activation memory for fewer decode calls",
    "summary": "A stacked-tiling candidate batches rank-local spatial tiles into one decoder call per temporal window; measured decode gains are exact for the reported latent but PP1 memory rises.",
    "applicability": {
      "hardware": [
        "NVIDIA B300 SXM6, SM103; PP4 uses GPUs 0–3"
      ],
      "software": [
        "vLLM 0.28.0 benchmark environment",
        "Base dff28e686711add0e929ce0c5660b09ef26c8c88 + Source revision b188874539903ecc04a8874b782d7d1a898d191c",
        "Exact decoder kernels from #6607; FP16 CUDA autocast"
      ],
      "models": [
        "MiniMax-H3 video VAE"
      ],
      "conditions": [
        "Fixed latent (1,24,62,48,84), 768×1344 decode, same latent broadcast to ranks",
        "One warmup + three measured decodes; PP latency is max rank wall-clock",
        "Remote VAE implements native stack_tiling; auto requires at least two global tiles per VAE rank"
      ]
    },
    "limitations": [
      "Unmerged candidate at import; branch/default/options may differ from current main.",
      "Clean current-branch PP2/PP8 latency is reported pending.",
      "Reported exactness applies to this latent, autocast mode and decoder revision; portability is unverified."
    ],
