    "claim-1": {
      "summary": "Three quantities become one step stale: per-request query length under adaptive speculation, per-request key length after rejected drafts, and input token ids for rows continuing from the previous batch. Each is repaired on device from a remap of the previous batch.",
      "layer": "L1",
      "pointers": [
