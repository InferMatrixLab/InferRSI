    },
    "claim-3": {
      "summary": "The default depends on how the engine object is built. The environment variable defaults false, while EngineArgs sets it with setdefault from a per-engine-type property that is true for NORMAL and COMPLETION and false for PROMPT. A README claim of 'enabled by default' and a false variable default can both be true of different entrypoints.",
      "layer": "L1",
      "pointers": [
