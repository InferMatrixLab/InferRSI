flowchart TB
  subgraph KPorts["Knowledge 端口"]
    READ["read(reference, revision?)"]
    COLL["collect(query / ids / pins / 过滤)"]
    RES["resource(reference, path, revision)"]
    UPD["create / update / history"]
  end
  subgraph BPorts["Benchmark 端口"]
    PREP["prepare(PrepareRequest)"]
    ASS["assess(prepared, 证据信封, locators)"]
  end
  subgraph HPorts["Harness 端口"]
    ALLOC["allocate_attempt"]
    EXEC["execute(ExecutionSpec)"]
    HREAD["read(attempt_id, record_version?)"]
  end
  KB["KnowledgeBundle<br/>id, kind, revision<br/>sources, applicability, state<br/>limitations, attribution, entrypoint<br/>resources, dependencies"]
  COL["Collection<br/>items: ref, revision, 逻辑记录<br/>omissions, collisions, no_match<br/>limitations；可选 selection"]
  PE["PreparedEvaluation<br/>schema_version, prepared_id, protocol_digest<br/>任务/grader 版本, protocol 引用<br/>operation, 判定范围<br/>冻结输入与判据, 所需证据<br/>候选契约, 固定 recipe/资源闭包<br/>未绑定须标明"]
  ES["ExecutionSpec<br/>schema_version, run_id, attempt_id, owner<br/>步骤/命令, 输入输出引用<br/>资源与时限；评测模式下<br/>prepared_ref, protocol_digest<br/>operation, validation_scope, 候选与预期身份"]
  ER["ExecutionRecord<br/>schema_version, run_id, attempt_id, record_version<br/>实际绑定与身份核对, phase/状态<br/>process_outcome, exit_code, 清理<br/>产物定位符, 容量/预留, 实际用量<br/>资源租约与确认释放（三类独立）<br/>已完成完整性检查（必填，无 verdict）<br/>评测：prepared_ref, protocol_digest<br/>operation, validation_scope, candidate/attempt"]
  EV["EvaluationResult<br/>schema_version, assessment_id, assessor 版本<br/>prepared/record 摘要, 候选与 attempt 身份<br/>claims: claim_id + scope + verdict<br/>指标有效性, 证据引用与缺失证据"]
  AC["AttemptContext<br/>run_id, attempt_id<br/>只分配身份：不占预算、不启动"]

  READ -->|"交付逻辑视图，不交 schema 2"| KB
  COLL -->|"交付集合信封"| COL
  RES -->|"固定 ref/revision 与安全逻辑路径，校验资源字节"| RB["资源字节<br/>不暴露私有存储 schema/来源快照"]
  UPD -->|"update: Bundle + expected + reason + evidence → 新 revision"| KB
  PREP -->|"冻结判据；不是执行授权"| PE
  PE -->|"Apps 不可变字节归档成功"| PR["固定 PreparedRef + artifact 定位/摘要；失败无有效引用"]
  ALLOC -->|"身份上下文"| AC
  AC -->|"写入 ExecutionSpec 的 run_id / attempt_id"| ES
  PE -->|"Apps 映射 worker 配方；须绑定已归档 PreparedRef"| ES
  PR -->|"固定引用进入 ExecutionSpec"| ES
  EXEC -->|"H 提交成功：对应记录载荷；无任务判定"| ER
  HREAD -->|"已提交固定修订；无快照则 NoCommittedRecord"| ER
  EXEC -->|"同一提交成功"| RR["固定 RecordRef + artifact：修订与字节摘要；失败无有效新引用"]
  ER -->|"Apps 按固定 RecordRef 核对并投影；错配拒绝，不判分"| ASS
  PE -->|"同一冻结判据"| ASS
  ASS -->|"唯一任务判定"| EV
  EV -->|"Apps 不可变字节归档成功"| AR["固定 AssessmentRef + artifact；失败无有效引用"]
