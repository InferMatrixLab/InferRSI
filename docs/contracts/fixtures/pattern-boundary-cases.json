{
  "document": "pattern-boundary-cases.json",
  "status": "Proposed",
  "nature": "Current schema regression vectors for contract-v1.schema.json pattern boundaries. Each case is a valid instance of a named definition and the same instance with CR or LF placed inside one scalar value or object key; the control characters are JSON escapes inside the string, not bytes after the JSON document. These vectors do not modify or replace fixtures/t108-v4/.",
  "path_base": "pattern values are JSON Pointers into schemas/contract-v1.schema.json",
  "end_assertion": "(?![\\s\\S])",
  "end_assertion_reason": "A pattern ends with (?![\\s\\S]), not $. In Python re, which jsonschema uses, $ also matches before one trailing LF; (?![\\s\\S]) matches only at the end of input in Python re and in ECMA-262 regular expressions with or without the u flag. Path keeps its $ ending as the control: its lookahead already rejects U+0000-U+001F and U+007F anywhere in the value.",
  "slots": {
    "value": "the instance is the scalar value itself",
    "property": "the instance is a complete valid object; a variant changes only the named property",
    "key": "the instance is an object with one key; a variant replaces only that key"
  },
  "variants": {
    "trailing_lf": "valid value followed by U+000A",
    "leading_lf": "U+000A followed by the valid value",
    "embedded_lf": "U+000A after the first character; only for values of two or more characters",
    "trailing_crlf": "valid value followed by U+000D U+000A",
    "trailing_cr": "valid value followed by U+000D"
  },
  "expected": "Every valid instance is accepted by its named definition, and every invalid variant is rejected by a pattern check of that definition.",
  "cases": [
    {
      "pattern": "/$defs/Id/pattern",
      "definition": "Id",
      "slot": "value",
      "instance": "att-1",
      "valid": "att-1",
      "invalid": {
        "trailing_lf": "att-1\n",
        "leading_lf": "\natt-1",
        "embedded_lf": "a\ntt-1",
        "trailing_crlf": "att-1\r\n",
        "trailing_cr": "att-1\r"
      }
    },
