     torch.testing.assert_close(out, torch.ones(1, 8, 2, 4))
 
 
+@pytest.mark.cpu
+@pytest.mark.parametrize("input_scale", [1.0, 256.0])
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float32])
+def test_laser_fp16_layout_preserves_conversion_boundaries(monkeypatch, input_scale, dtype):
+    monkeypatch.setenv("MINDIE_SD_FA_TYPE", "ascend_laser_attention")
+    calls = []
+
+    def reference_adapter(query, key, value, *, head_first=False, **kwargs):
+        calls.append((query, key, value, head_first, kwargs))
+        output_dtype = query.dtype
+        tensors = (query, key, value) if head_first else (x.transpose(1, 2) for x in (query, key, value))
+        q, k, v = (x.to(torch.float16).contiguous() for x in tensors)
+        # A deterministic stand-in for the unchanged native kernel. This test
+        # checks the real adapter's dtype/layout/range boundaries, not Laser.
+        out = q.float() * 1.3 + k.float().mean(2, keepdim=True) + v.float().mean(2, keepdim=True)
+        out = out.to(torch.float16).to(output_dtype)
+        return out if head_first else out.transpose(1, 2)
+
+    _fake_mindiesd(monkeypatch, attention_forward=reference_adapter)
+    impl = _npu_impl()
+    q, k, v = (torch.randn(1, 16, 2, 4, dtype=dtype)[:, ::2] for _ in range(3))
+    cu = torch.tensor([0, 5, 8], dtype=torch.int32)
+    extra = {
+        "cu_seqlens_q": cu,
+        "cu_seqlens_k": cu,
+        "max_seqlen_q": 5,
+        "max_seqlen_k": 5,
+        "laser_input_scale": input_scale,
+    }
+    baseline = impl._forward_prefix_kv_slice_npu(q, k, v, extra)
+    impl.npu_laser_fp16_layout = True
+    candidate = impl._forward_prefix_kv_slice_npu(q, k, v, extra)
+    assert candidate.dtype == dtype and candidate.shape == q.shape
+    assert torch.equal(baseline, candidate)
+    cq, ck, cv, head_first, kwargs = calls[-1]
+    assert head_first is (dtype == torch.bfloat16)
+    if head_first:
+        assert all(x.is_contiguous() and x.dtype == torch.float16 for x in (cq, ck, cv))
+        assert cq.shape == (1, 2, 8, 4) and ck.shape == cv.shape == (1, 2, 5, 4)
+    assert kwargs["attn_mask"] is None
+    assert kwargs["scale"] == 0.5 * input_scale**2
+
+
+@pytest.mark.cpu
+def test_laser_fp16_layout_requires_boolean_config(monkeypatch):
+    from vllm_omni.diffusion.attention.backends import flash_attn
+
+    monkeypatch.setattr(
+        flash_attn,
+        "get_current_diffusion_config_or_none",
+        lambda: SimpleNamespace(additional_config={"npu_laser_fp16_layout": "false"}),
+    )
+    with pytest.raises(ValueError, match="must be a boolean"):
+        _npu_impl()
+    monkeypatch.setattr(
+        flash_attn,
+        "get_current_diffusion_config_or_none",
+        lambda: SimpleNamespace(additional_config={"npu_laser_fp16_layout": True}),
+    )
+    assert _npu_impl().npu_laser_fp16_layout is True
+
