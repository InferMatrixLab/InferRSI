diff --git a/tests/test_collect_resource_memo.py b/tests/test_collect_resource_memo.py
new file mode 100644
index 00000000..0c468e5d
--- /dev/null
+++ b/tests/test_collect_resource_memo.py
@@ -0,0 +1,65 @@
+"""Request-local resource reuse must not cache mutable Bundle validation."""
+import pytest
+
+from inferrsi.knowledge_operations import Bundle, KnowledgeReader, RevisionConflict, _hash
+
+CGROUP = "inferrsi.common.skills.cgroup_resource_controls"
+
+
+def small_bundle(data=b"original"):
+    return Bundle({"id": "example", "kind": "skill", "sources": [{"type": "unknown"}],
+                   "applicability": {}, "state": "active", "limitations": [],
+                   "attribution": {}, "entrypoint": "SKILL.md"}, {"SKILL.md": data}, {})
+
+
+def test_memo_keys_exact_bytes_not_path_or_mutable_bundle():
+    memo = {}
+    bundle = small_bundle()
+    original = bundle._view(resources_seen=memo)
+    assert bundle._view(resources_seen=memo) == original
+    other = small_bundle(b"other owner")
+    assert other._view(resources_seen=memo)["resources"]["SKILL.md"] == _hash(b"other owner")
+    bundle.content["SKILL.md"] = b"changed"
+    changed = bundle._view(resources_seen=memo)
+    assert changed["revision"] != original["revision"]
+    assert changed["resources"]["SKILL.md"] == _hash(b"changed")
+    assert bundle.view() == changed
+    bundle.metadata["limitations"].append("new limitation")
+    assert bundle._view(resources_seen=memo)["revision"] != changed["revision"]
+    bundle.metadata["id"] = "INVALID"
+    with pytest.raises(ValueError, match="identity"):
+        bundle._view(resources_seen=memo)
+
+
+def test_memo_does_not_skip_security_or_dependency_validation():
+    bundle, memo = small_bundle(), {}
+    bundle._view(resources_seen=memo)
+    bundle.dependencies["SKILL.md"] = "sha256:" + "0" * 64
+    with pytest.raises(RevisionConflict):
+        bundle._view(resources_seen=memo)
+    bundle.dependencies.clear()
+    bundle.content["../SKILL.md"] = b"original"
+    with pytest.raises(ValueError, match="Unsafe"):
+        bundle._view(resources_seen=memo)
+    del bundle.content["../SKILL.md"]
+    bundle.content["SKILL.md"] = bytearray(b"original")
+    with pytest.raises(ValueError, match="bytes"):
+        bundle._view(resources_seen=memo)
+
+
+def test_collect_resource_memo_is_not_retained_between_requests(monkeypatch):
+    reader = KnowledgeReader()
+    seen = []
+    original = Bundle._view
+
+    def capture(self, *, material=False, resources_seen=None):
+        seen.append(resources_seen)
+        return original(self, material=material, resources_seen=resources_seen)
+
+    monkeypatch.setattr(Bundle, "_view", capture)
+    one = reader.collect(ids=[CGROUP])
+    first = seen[-1]
+    two = reader.collect(ids=[CGROUP])
+    assert one == two
+    assert first is not seen[-1]
+    assert first and seen[-1]
