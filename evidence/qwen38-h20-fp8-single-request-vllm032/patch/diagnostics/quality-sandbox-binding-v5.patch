@@ -0,0 +1,116 @@
+"""Bind quality evidence to a separately frozen evaluator protocol.
+
+This reader authenticates identities and report scope, not isolation by itself.
+The qualification artifact must contain independently reviewed execution evidence
+before its digest is accepted into the campaign freeze. Test fixtures are not
+qualification artifacts. No OCI identity is inferred from readonly file binds.
+"""
+
+import hashlib
+import json
+import re
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def unique_keys(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate provenance key")
+        result[key] = value
+    return result
+
+
+def document(raw):
+    value = json.loads(raw, object_pairs_hook=unique_keys)
+    if not isinstance(value, dict):
+        raise TypeError("provenance must be an object")
+    return value
+
+
+def digest(value):
+    if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
+        raise ValueError("invalid provenance digest")
+
+
+def same_identity(actual, expected):
+    return json.dumps(actual, sort_keys=True, allow_nan=False) == json.dumps(
+        expected, sort_keys=True, allow_nan=False
+    )
+
+
+def protocol_identity(protocol, evaluator_revision):
+    hashes = {
+        "executor_sha256",
+        "driver_sha256",
+        "sandbox_binary_sha256",
+        "policy_sha256",
+        "qualification_sha256",
+    }
+    if set(protocol) != hashes | {
+        "schema_version",
+        "runtime_kind",
+        "runtime_digest",
+        "evaluator_revision",
+    }:
+        raise ValueError("unexpected evaluator protocol schema")
+    if type(protocol["schema_version"]) is not int or protocol["schema_version"] != 1:
+        raise ValueError("unsupported evaluator protocol version")
+    if (
+        protocol["runtime_kind"] != "readonly-bind-set-v1"
+        or protocol["evaluator_revision"] != evaluator_revision
+    ):
+        raise ValueError("evaluator kind or revision differs")
+    value = protocol["runtime_digest"]
+    if not isinstance(value, str) or not value.startswith("sha256:"):
+        raise ValueError("invalid readonly-runtime digest")
+    digest(value[7:])
+    for name in hashes:
+        digest(protocol[name])
+    return {name: value for name, value in protocol.items() if name != "qualification_sha256"}
+
+
+def frozen_protocol(path, expected_sha256, qualification_path, evaluator_revision):
+    if path is None or qualification_path is None:
+        raise ValueError("independent frozen evaluator protocol and qualification required")
+    digest(expected_sha256)
+    protocol_raw = path.read_bytes()
+    if sha(protocol_raw) != expected_sha256:
+        raise ValueError("frozen evaluator protocol bytes changed")
+    protocol = document(protocol_raw)
+    identity = protocol_identity(protocol, evaluator_revision)
+    qualification_raw = qualification_path.read_bytes()
+    if sha(qualification_raw) != protocol["qualification_sha256"]:
+        raise ValueError("frozen qualification artifact changed")
+    qualification = document(qualification_raw)
+    if (
+        qualification.get("scope") != "generated-code-executor"
+        or qualification.get("verdict") != "PASS"
+        or qualification.get("qualified_generated_code_executor") is not True
+        or not same_identity(qualification.get("identity"), identity)
+    ):
+        raise ValueError("qualification scope or evaluator identity differs")
+    return protocol
+
+
+def execution_record(raw, protocol, results_raw):
+    if raw is None:
+        raise ValueError("sandbox execution provenance required")
+    record = document(raw)
+    if (
+        not same_identity(record.get("protocol"), protocol)
+        or record.get("network") != "none"
+        or type(record.get("exit_code")) is not int
+        or record["exit_code"] != 0
+        or record.get("timed_out") is not False
+        or record.get("cleanup_complete") is not True
+        or record.get("qualified_generated_code_executor") is not True
+        or record.get("results_sha256") != sha(results_raw)
+    ):
+        raise ValueError("execution differs from frozen evaluator or did not complete")
+    for name in ("samples_sha256", "dataset_sha256"):
+        digest(record.get(name))
+    return record
