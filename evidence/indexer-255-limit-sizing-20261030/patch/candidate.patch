@@ -0,0 +1,99 @@
+"""Count saturation skips only redundant normal-view payload sizing."""
+import pytest
+
+from inferrsi import knowledge_operations as operations
+from inferrsi.knowledge_operations import Bundle, KnowledgeReader
+
+
+class CustomBundle(Bundle):
+    pass
+
+
+class InvalidViewBundle(Bundle):
+    def view(self, *, material=False):
+        return {**super().view(material=material), "custom": object()}
+
+
+def bundle(identity, cls=Bundle):
+    return cls({
+        "id": identity, "kind": "knowledge", "entrypoint": "entry.md",
+        "sources": [{"type": "unknown"}], "applicability": {}, "state": "test",
+        "limitations": [], "attribution": "test", "required_resources": ["entry.md"],
+    }, {"entry.md": identity.encode()}, {})
+
+
+class FixtureReader(KnowledgeReader):
+    def __init__(self, bundles):
+        super().__init__()
+        self.bundles = {item.metadata["id"]: item for item in bundles}
+        self.reads = []
+
+    def records(self):
+        return {identity: {} for identity in self.bundles}
+
+    def _read(self, qualified, revision):
+        self.reads.append(qualified)
+        return self.bundles[qualified.partition(":")[2]]
+
+
+def size_calls(monkeypatch):
+    original, seen = operations._json, []
+
+    def observe(value):
+        if isinstance(value, dict) and "authority" in value and "ref" in value:
+            seen.append(value["id"])
+        return original(value)
+
+    monkeypatch.setattr(operations, "_json", observe)
+    return seen
+
+
+@pytest.mark.parametrize("material", [False, True])
+def test_saturated_count_omits_without_sizing_but_reads_every_bundle(monkeypatch, material):
+    reader = FixtureReader([bundle(name) for name in ("a", "b", "c")])
+    seen = size_calls(monkeypatch)
+    result = reader.collect(limit=1, material=material)
+    assert seen == ["a"]
+    assert reader.reads == ["package:a", "package:b", "package:c"]
+    assert result["omissions"] == [
+        {"id": "package:b", "reason": "output_limit"},
+        {"id": "package:c", "reason": "output_limit"},
+    ]
+    assert result["material_bytes"] == len(operations._json(result["items"][0]))
+
+
+@pytest.mark.parametrize("max_bytes", [None, 1, 100000])
+@pytest.mark.parametrize("material", [False, True])
+def test_custom_subclass_fallback_is_identical_to_normal_views(max_bytes, material):
+    normal = FixtureReader([bundle(n) for n in ("a", "b", "c")])
+    legacy = FixtureReader([bundle(n, CustomBundle) for n in ("a", "b", "c")])
+    options = dict(limit=1, max_bytes=max_bytes, material=material, context_bytes=100)
+    assert normal.collect(**options) == legacy.collect(**options)
+
+
+def test_byte_budget_rejections_still_size_every_unsaturated_item(monkeypatch):
+    reader = FixtureReader([bundle(n) for n in ("a", "b", "c")])
+    seen = size_calls(monkeypatch)
+    result = reader.collect(limit=1, max_bytes=1)
+    assert seen == ["a", "b", "c"]
+    assert result["no_match"] and len(result["omissions"]) == 3
+
+
+def test_invalid_custom_view_still_raises_after_count_limit():
+    reader = FixtureReader([bundle("a"), bundle("b", InvalidViewBundle)])
+    with pytest.raises(TypeError, match="not JSON serializable"):
+        reader.collect(limit=1)
+
+
+def test_invalid_normal_resource_is_reported_even_after_count_limit():
+    invalid = bundle("b")
+    invalid.content["../escape"] = b"unsafe"
+    result = FixtureReader([bundle("a"), invalid]).collect(limit=1)
+    assert result["omissions"][0]["reason"] == "invalid"
+    assert "Unsafe bundle path" in result["omissions"][0]["detail"]
+
+
+@pytest.mark.parametrize("limit", [0, None, -1, True])
+def test_invalid_limits_still_rejected(limit):
+    with pytest.raises(ValueError, match="positive integer"):
+        FixtureReader([bundle("a")]).collect(limit=limit)
