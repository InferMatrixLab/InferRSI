diff --git a/vllm_ascend/ops/triton/deepseek_v41_cutoff_ties.py b/vllm_ascend/ops/triton/deepseek_v41_cutoff_ties.py
new file mode 100644
index 0000000..d2d8145
--- /dev/null
+++ b/vllm_ascend/ops/triton/deepseek_v41_cutoff_ties.py
@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Stable selection of the lowest column IDs at a known TopK cutoff."""
+
+import torch
+from vllm.triton_utils import tl, triton
+
+from vllm_ascend.ops.triton.triton_utils import get_element, get_vectorcore_num
+
+
+@triton.jit
+def _count_cutoff(scores, top_values, lengths, counts, WIDTH: tl.constexpr, K: tl.constexpr,
+                  TILE: tl.constexpr, TILES: tl.constexpr, PROGRAMS_PER_ROW: tl.constexpr):
+    program = tl.program_id(0)
+    row = program // PROGRAMS_PER_ROW
+    length = tl.minimum(tl.maximum(tl.load(lengths + row), 0), WIDTH).to(tl.int32)
+    cutoff = tl.load(top_values + row * K + K - 1).to(tl.float32)
+    for tile in range(program % PROGRAMS_PER_ROW, tl.cdiv(length, TILE), PROGRAMS_PER_ROW):
+        columns = tile * TILE + tl.arange(0, TILE)
+        values = tl.load(scores + row * WIDTH + columns, columns < length, 0).to(tl.float32)
+        found = (columns < length) & (values == cutoff)
+        tl.store(counts + row * TILES + tile, tl.sum(found.to(tl.int32), axis=0))
+
+
+@triton.jit
+def _pack_cutoff(scores, top_values, lengths, counts, packed, WIDTH: tl.constexpr, K: tl.constexpr,
+                 TILE: tl.constexpr, TILES: tl.constexpr, COUNT_BLOCK: tl.constexpr,
+                 PROGRAMS_PER_ROW: tl.constexpr):
+    program = tl.program_id(0)
+    row = program // PROGRAMS_PER_ROW
+    length = tl.minimum(tl.maximum(tl.load(lengths + row), 0), WIDTH).to(tl.int32)
+    active_tiles = tl.cdiv(length, TILE)
+    cutoff = tl.load(top_values + row * K + K - 1).to(tl.float32)
+    count_cols = tl.arange(0, COUNT_BLOCK)
+    tile_counts = tl.load(counts + row * TILES + count_cols, count_cols < active_tiles, 0)
+    live_matches = tl.sum(tile_counts, axis=0)
+    suffix_matches = tl.where(cutoff == -float("inf"), WIDTH - length, 0)
+    if (live_matches > 0) & (live_matches + suffix_matches > 1):
+        for tile in range(program % PROGRAMS_PER_ROW, active_tiles, PROGRAMS_PER_ROW):
+            count = tl.load(counts + row * TILES + tile)
+            before = tl.sum(tl.where(count_cols < tile, tile_counts, 0), axis=0)
+            if (count > 0) & (before < K):
+                lanes = tl.arange(0, TILE)
+                columns = tile * TILE + lanes
+                values = tl.load(scores + row * WIDTH + columns, columns < length, 0).to(tl.float32)
+                found = (columns < length) & (values == cutoff)
+                if count == TILE:
+                    offsets = before + lanes
+                    tl.store(packed + row * K + offsets, columns, offsets < K)
+                else:
+                    # Match the Ascend sparse remapping strategy for ordered chunk compaction.
+                    # The scan runs only for a chunk with ties that can enter the first K.
+                    keep = found.to(tl.int32)
+                    written = 0
+                    for i in range(TILE):
+                        if (get_element(keep, (i,)) != 0) & (before + written < K):
+                            tl.store(packed + row * K + before + written, tile * TILE + i)
+                            written += 1
+
+
+@triton.jit
+def _replace_cutoff(top_values, top_indices, lengths, counts, packed, output, WIDTH: tl.constexpr,
+                    K: tl.constexpr, TILE: tl.constexpr, TILES: tl.constexpr,
+                    COUNT_BLOCK: tl.constexpr, K_BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    length = tl.minimum(tl.maximum(tl.load(lengths + row), 0), WIDTH).to(tl.int32)
+    cutoff = tl.load(top_values + row * K + K - 1).to(tl.float32)
+    columns = tl.arange(0, K_BLOCK)
+    values = tl.load(top_values + row * K + columns, columns < K, 0).to(tl.float32)
+    indices = tl.load(top_indices + row * K + columns, columns < K, 0)
+    at_cutoff = (columns < K) & (values == cutoff)
+    # torch.topk returns sorted values. Equal cutoff scores occupy its suffix.
+    rank = columns - K + tl.sum(at_cutoff.to(tl.int32), axis=0)
+    tc = tl.arange(0, COUNT_BLOCK)
+    live_matches = tl.sum(tl.load(counts + row * TILES + tc, tc < tl.cdiv(length, TILE), 0), axis=0)
+    padded_matches = tl.where(cutoff == -float("inf"), WIDTH - length, 0)
+    replace = at_cutoff & (live_matches + padded_matches != 1)
+    live = replace & (rank >= 0) & (rank < live_matches)
+    selected = tl.load(packed + row * K + tl.maximum(rank, 0), live, WIDTH)
+    tail = length + rank - live_matches
+    padded = (cutoff == -float("inf")) & (tail >= length) & (tail < WIDTH)
+    corrected = tl.where(live, selected, tl.where(padded, tail, WIDTH))
+    tl.store(output + row * K + columns, tl.where(replace, corrected.to(tl.int64), indices), columns < K)
+
+
+_TILE_COLUMNS = 256
+
+
+def replace_cutoff_ties(scores: torch.Tensor, values: torch.Tensor, indices: torch.Tensor,
+                        lengths: torch.Tensor) -> torch.Tensor:
+    """Correct ties using the live region and the source's implicit -inf suffix."""
+    rows, width = scores.shape
+    k = values.shape[-1]
+    tiles = triton.cdiv(width, _TILE_COLUMNS)
+    count_block = triton.next_power_of_2(tiles)
+    programs = max(1, get_vectorcore_num() // rows)
+    counts = torch.empty((rows, tiles), dtype=torch.int32, device=scores.device)
+    packed = torch.empty((rows, k), dtype=torch.int32, device=scores.device)
+    result = torch.empty_like(indices)
+    grid = (rows * programs,)
+    _count_cutoff[grid](scores, values, lengths, counts, width, k, _TILE_COLUMNS, tiles, programs)
+    _pack_cutoff[grid](scores, values, lengths, counts, packed, width, k, _TILE_COLUMNS, tiles, count_block, programs)
+    _replace_cutoff[(rows,)](
+        values, indices, lengths, counts, packed, result,
+        width, k, _TILE_COLUMNS, tiles, count_block, triton.next_power_of_2(k),
+    )
+    return result
