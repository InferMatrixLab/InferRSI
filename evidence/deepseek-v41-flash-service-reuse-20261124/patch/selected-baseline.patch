new file mode 100644
index 0000000..1475a1e
--- /dev/null
+++ b/vllm_ascend/ops/triton/deepseek_v41_hc_mix.py
@@ -0,0 +1,156 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Vector kernels for the four-stream DeepSeek V4.1 HC residual transforms."""
+
+import torch
+from vllm import envs
+from vllm.triton_utils import HAS_TRITON
+
+if HAS_TRITON and not envs.VLLM_BATCH_INVARIANT:
+    from vllm.triton_utils import tl, triton
+
+    @triton.jit
+    def _weighted4(x0, x1, x2, x3, weights, STRIDE: tl.constexpr):
+        # Ascend ReduceSum over the four HC streams accumulates in stream order.
+        p0 = x0 * tl.load(weights)
+        p1 = x1 * tl.load(weights + STRIDE)
+        p2 = x2 * tl.load(weights + 2 * STRIDE)
+        p3 = x3 * tl.load(weights + 3 * STRIDE)
+        return ((p0 + p1) + p2) + p3
+
+    @triton.jit
+    def _hc_mix_kernel(states, pre, output, H: tl.constexpr, BLOCK: tl.constexpr):
+        row = tl.program_id(0)
+        cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+        offsets = row * 4 * H + cols
+        x0 = tl.load(states + offsets, cols < H, 0).to(tl.float32)
+        x1 = tl.load(states + offsets + H, cols < H, 0).to(tl.float32)
+        x2 = tl.load(states + offsets + 2 * H, cols < H, 0).to(tl.float32)
+        x3 = tl.load(states + offsets + 3 * H, cols < H, 0).to(tl.float32)
+        mixed = _weighted4(x0, x1, x2, x3, pre + row * 4, 1)
+        tl.store(output + row * H + cols, mixed, cols < H)
+
+    @triton.jit
+    def _hc_residual_kernel(
+        sublayer, states, post, comb, active, output, H: tl.constexpr, BLOCK: tl.constexpr,
+        HAS_ACTIVE: tl.constexpr,
+    ):
+        row = tl.program_id(0)
+        cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+        offsets = row * 4 * H + cols
+        x0 = tl.load(states + offsets, cols < H, 0).to(tl.float32)
+        x1 = tl.load(states + offsets + H, cols < H, 0).to(tl.float32)
+        x2 = tl.load(states + offsets + 2 * H, cols < H, 0).to(tl.float32)
+        x3 = tl.load(states + offsets + 3 * H, cols < H, 0).to(tl.float32)
+        sublayer_mask = cols < H
+        if HAS_ACTIVE:
+            sublayer_mask = sublayer_mask & (tl.load(active + row) != 0)
+        sublayer_values = tl.load(sublayer + row * H + cols, sublayer_mask, 0).to(tl.float32)
+        for stream in tl.static_range(4):
+            mixed = _weighted4(x0, x1, x2, x3, comb + row * 16 + stream, 4)
+            weighted_sublayer = sublayer_values * tl.load(post + row * 4 + stream)
+            tl.store(output + offsets + stream * H, weighted_sublayer + mixed, cols < H)
+
+    @triton.jit
+    def _hc_widen_square_kernel(
+        states, widened, squared, SIZE: tl.constexpr, BLOCK: tl.constexpr, STORE_WIDENED: tl.constexpr,
+    ):
+        offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+        live = offsets < SIZE
+        values = tl.load(states + offsets, live, 0).to(tl.float32)
+        if STORE_WIDENED:
+            tl.store(widened + offsets, values, live)
+        tl.store(squared + offsets, values * values, live)
+
+    @triton.jit
+    def _hc_affine4_kernel(mixes, scale, base, gates, comb):
+        row = tl.program_id(0)
+        gates_cols = tl.arange(0, 8)
+        comb_cols = tl.arange(0, 16)
+        stem = mixes + row * 24
+        gates_logits = tl.load(stem + gates_cols) * tl.load(scale + gates_cols // 4)
+        comb_logits = tl.load(stem + 8 + comb_cols) * tl.load(scale + 2)
+        tl.store(gates + row * 8 + gates_cols, gates_logits + tl.load(base + gates_cols))
+        tl.store(comb + row * 16 + comb_cols, comb_logits + tl.load(base + 8 + comb_cols))
+
+    _FEATURE_TILE = 1024
+
+    def hc_widen_square(states: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        widened = torch.empty_like(states, dtype=torch.float32)
+        squared = torch.empty_like(widened)
+        size = states.numel()
+        _hc_widen_square_kernel[(triton.cdiv(size, _FEATURE_TILE),)](
+            states, widened, squared, size, _FEATURE_TILE, True,
+        )
+        return widened, squared
+
+    @triton.jit
+    def _rms_scale_kernel(
+        states, weight, rstd, active, output, WIDTH: tl.constexpr, BLOCK: tl.constexpr,
+        HAS_ACTIVE: tl.constexpr,
+    ):
+        row = tl.program_id(0)
+        cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+        offsets = row * WIDTH + cols
+        values = tl.load(states + offsets, cols < WIDTH, 0).to(tl.float32)
+        scales = tl.load(weight + cols, cols < WIDTH, 0).to(tl.float32)
+        normalized = values * tl.load(rstd + row)
+        result = (scales * normalized).to(tl.bfloat16, fp_downcast_rounding="rtne")
+        if HAS_ACTIVE:
+            result = tl.where(tl.load(active + row) != 0, result, tl.full((), 0.0, tl.bfloat16))
+        tl.store(output + offsets, result, cols < WIDTH)
+
+    def rms_square_bf16(states: torch.Tensor) -> torch.Tensor:
+        squared = torch.empty_like(states, dtype=torch.float32)
+        size = states.numel()
+        _hc_widen_square_kernel[(triton.cdiv(size, _FEATURE_TILE),)](
+            states, squared, squared, size, _FEATURE_TILE, False,
+        )
+        return squared
+
+    def rms_scale_bf16(
+        states: torch.Tensor, weight: torch.Tensor, rstd: torch.Tensor, active: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        rows, width = states.shape
+        out = torch.empty_like(states)
+        _rms_scale_kernel[(rows, triton.cdiv(width, _FEATURE_TILE))](
+            states, weight, rstd, states if active is None else active, out, width, _FEATURE_TILE,
+            active is not None, enable_fp_fusion=False,
+        )
+        return out
+
+    def hc_affine4(mixes: torch.Tensor, scale: torch.Tensor, base: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        rows = mixes.shape[0]
+        gates = mixes.new_empty((rows, 8))
+        comb = mixes.new_empty((rows, 4, 4))
+        _hc_affine4_kernel[(rows,)](mixes, scale, base, gates, comb, enable_fp_fusion=False)
+        return gates, comb
