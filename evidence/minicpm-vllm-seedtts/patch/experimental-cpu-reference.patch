+    def prepare_prompts(self, keys: list[tuple[str, str]], workers: int) -> dict[tuple[str, str], PromptFeatures]:
+        """Parallelize CPU features only; preserve accelerator submission order."""
+        from concurrent.futures import ThreadPoolExecutor
+
+        keys = list(dict.fromkeys(keys))
+        missing = [key for key in keys if key not in self._prompt_features]
+        if workers <= 1 or len(missing) <= 1:
+            return {key: self.prepare_prompt(*key) for key in keys}
+        logger.info("Parallel CPU reference preparation: %d misses, %d workers", len(missing), min(workers, len(missing)))
+        previous_dtype = torch.get_default_dtype()
+        try:
+            torch.set_default_dtype(torch.float32)
+            with ThreadPoolExecutor(max_workers=min(workers, len(missing))) as pool:
+                prepared = list(pool.map(self._token2wav._prepare_prompt_cpu, [key[1] for key in missing]))
+            with _autocast_disabled(self.speech_window.device):
+                for key, cpu_features in zip(missing, prepared, strict=True):
+                    values = self._token2wav._prepare_prompt(key[1], cpu_features=cpu_features)
+                    self._prompt_features[key] = PromptFeatures(
+                        cache_key=key, speech_tokens=values[0], speaker_embedding=values[2], mels=values[3]
+                    )
+        finally:
+            torch.set_default_dtype(previous_dtype)
+        return {key: self._prompt_features[key] for key in keys}
