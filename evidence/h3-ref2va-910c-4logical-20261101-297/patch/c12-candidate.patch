@@ -0,0 +1,226 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+"""Experimental request-owned residual prediction from current H3 features."""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Mapping
+from typing import Any
+from weakref import ref
+
+import torch
+import torch.distributed as dist
+
+from .reference_kv_cache_dit import MiniMaxH3CachedAdapter, MiniMaxH3CachedBlocks
+
+
+def alignment_cache_enabled(config: Any) -> bool:
+    cache = getattr(config, "cache_config", {})
+    enabled = (
+        cache.get("minimax_h3_alignment_cache", False)
+        if isinstance(cache, Mapping)
+        else getattr(cache, "minimax_h3_alignment_cache", False)
+    )
+    if type(enabled) is not bool:
+        raise ValueError("minimax_h3_alignment_cache must be boolean")
+    if not enabled:
+        return False
+    parallel = getattr(config, "parallel_config", None)
+    taylor = cache.get("enable_taylorseer", False) if isinstance(cache, Mapping) else cache.enable_taylorseer
+    if (
+        getattr(config, "task_type", None) != "ref2va"
+        or getattr(config, "cache_backend", None) != "cache_dit"
+        or getattr(config, "kv_offload_config", None) is not None
+        or taylor
+        or (getattr(parallel, "data_parallel_size", 1) or 1) != 1
+        or (getattr(parallel, "cfg_parallel_size", 1) or 1) != 1
+    ):
+        raise ValueError("H3 alignment cache requires Ref2VA Cache-DiT, DP1/CFG1, no Taylor/RefKV")
+    return True
+
+
+class MiniMaxH3AlignedCacheState:
+    """Own three real prefix/residual pairs and structural row identities."""
+
+    def __init__(self) -> None:
+        self.history: list[tuple[torch.Tensor, torch.Tensor]] = []
+        self.groups: torch.Tensor | None = None
+        self.coefficients: torch.Tensor | None = None
+        self.step = -1
+        self.closed = False
+        self.computed = self.predicted = self.vetoes = 0
+
+    def configure(self, branch) -> None:
+        groups = torch.full((branch.seq_len,), -1, dtype=torch.long, device=branch.device)
+        groups[branch.text_pos_dev] = 0
+        groups[branch.img_pos_dev] = torch.where(branch.update_mask_dev, 2, 1)
+        groups[branch.audio_pos_dev] = torch.where(branch.audio_update_mask_dev, 4, 3)
+        self.set_groups(groups)
+
+    def set_groups(self, groups: torch.Tensor) -> None:
+        if self.groups is not None or self.closed or groups.ndim != 1:
+            raise ValueError("H3 alignment groups must be initialized once per request")
+        self.groups = groups.detach().clone()
+
+    def begin_step(self, step: int, *_clocks) -> None:
+        if self.closed or step != self.step + 1:
+            raise RuntimeError("H3 alignment cache requires consecutive request steps")
+        self.step = step
+        self.coefficients = None
+
+    def _local_groups(self, rows: int) -> torch.Tensor:
+        if self.groups is None:
+            raise RuntimeError("H3 alignment cache has no structural groups")
+        if self.groups.numel() == rows:
+            return self.groups
+        from vllm_omni.diffusion.distributed.parallel_state import (
+            get_sequence_parallel_rank,
+            get_sequence_parallel_world_size,
+        )
+
+        size, rank = get_sequence_parallel_world_size(), get_sequence_parallel_rank()
+        if self.groups.numel() != rows * size:
+            raise ValueError("H3 alignment cache requires equal pure-Ulysses shards")
+        return self.groups.narrow(0, rows * rank, rows)
+
+    def record(self, prefix: torch.Tensor, residual: torch.Tensor) -> None:
+        if self.closed or self.step < 0 or prefix.ndim != 2 or prefix.shape != residual.shape:
+            raise RuntimeError("H3 alignment cache requires an open step and matching matrices")
+        self.history.append((prefix.detach().float().clone(), residual.detach().float().clone()))
+        del self.history[:-3]
+        self.computed += 1
+
+    def can_predict(self, current: torch.Tensor, *, parallelized: bool) -> bool:
+        if len(self.history) != 3 or self.closed:
+            self.vetoes += 1
+            return False
+        if any(f.shape != current.shape or f.device != current.device for f, _ in self.history):
+            self.history.clear()
+            self.vetoes += 1
+            return False
+        groups = self._local_groups(current.shape[0])
+        f0, f1, f2 = [item[0] for item in self.history]
+        d0, d1, u = f2 - f1, f1 - f0, current.float() - f2
+        # Reduce feature products per row once; grouping never materializes
+        # a [groups, rows, hidden] tensor and padding contributes no products.
+        products = torch.stack(
+            [
+                (d0 * d0).sum(-1),
+                (d0 * d1).sum(-1),
+                (d1 * d1).sum(-1),
+                (d0 * u).sum(-1),
+                (d1 * u).sum(-1),
+                (u * u).sum(-1),
+            ],
+            dim=-1,
+        )
+        totals = torch.stack([torch.where((groups == group)[:, None], products, 0.0).sum(0) for group in range(5)])
+        if parallelized:
+            if not dist.is_initialized():
+                raise RuntimeError("H3 alignment requires initialized collectives")
+            # DP1/CFG1, pure USP: WORLD is the four-rank model group. Empty
+            # local audio/reference groups must still enter this collective.
+            dist.all_reduce(totals, op=dist.ReduceOp.SUM)
+        coefficients = []
+        valid = True
+        for g00, g01, g11, h0, h1, uu in totals.cpu().double().tolist():
+            if not all(math.isfinite(x) for x in [g00, g01, g11, h0, h1, uu]):
+                valid = False
+                coefficients.append((0.0, 0.0))
+                continue
+            if uu == 0:
+                coefficients.append((0.0, 0.0))
+                continue
+            ridge = 1e-4 * (g00 + g11)
+            determinant = (g00 + ridge) * (g11 + ridge) - g01 * g01
+            if determinant <= 0:
+                valid = False
+                coefficients.append((0.0, 0.0))
+                continue
+            a0 = ((g11 + ridge) * h0 - g01 * h1) / determinant
+            a1 = ((g00 + ridge) * h1 - g01 * h0) / determinant
+            error = max(0.0, uu - 2 * (a0 * h0 + a1 * h1) + a0 * a0 * g00 + 2 * a0 * a1 * g01 + a1 * a1 * g11)
+            valid &= abs(a0) + abs(a1) <= 8.0 and error <= 0.25**2 * uu
+            coefficients.append((a0, a1))
+        if not valid:
+            self.vetoes += 1
+            return False
+        self.coefficients = torch.tensor(coefficients, dtype=torch.float32, device=current.device)
+        return True
+
+    def predict(self, current: torch.Tensor) -> torch.Tensor:
+        if self.coefficients is None or self.closed:
+            raise RuntimeError("H3 alignment prediction has not been admitted")
+        groups = self._local_groups(current.shape[0])
+        coefficients = self.coefficients[groups.clamp(min=0)]
+        coefficients = torch.where((groups >= 0)[:, None], coefficients, 0.0)
+        b0, b1, b2 = [item[1] for item in self.history]
+        predicted = b2 + coefficients[:, :1] * (b2 - b1) + coefficients[:, 1:] * (b1 - b0)
+        self.predicted += 1
+        return (current.float() + predicted).to(current.dtype).contiguous()
+
+    def stats(self) -> dict[str, int]:
+        return {"computed": self.computed, "predicted": self.predicted, "vetoes": self.vetoes}
+
+    def close(self) -> None:
+        self.history.clear()
+        self.groups = self.coefficients = None
+        self.closed = True
+
+
+class _AlignmentManager:
+    def __init__(self, manager: Any, owner) -> None:
+        self._manager, self._owner = manager, ref(owner)
+
+    def __getattr__(self, name):
+        return getattr(self._manager, name)
+
+    def can_cache(self, states, *args, **kwargs):
+        allowed = self._manager.can_cache(states, *args, **kwargs)
+        owner = self._owner()
+        return allowed and owner._alignment_state.can_predict(
+            owner._alignment_prefix, parallelized=kwargs.get("parallelized", False)
+        )
+
+    def set_Bn_buffer(self, buffer, prefix="Bn"):
+        owner = self._owner()
+        owner._alignment_state.record(owner._alignment_prefix, buffer)
+        self._manager.set_Bn_buffer(buffer, prefix=prefix)
+
+    def apply_cache(self, hidden_states, encoder_hidden_states=None, **kwargs):
+        if encoder_hidden_states is not None or not self._manager.is_cache_residual():
+            raise ValueError("H3 alignment supports only residual-cached packed hidden states")
+        return self._owner()._alignment_state.predict(hidden_states), None
+
+
+class MiniMaxH3AlignedCachedBlocks(MiniMaxH3CachedBlocks):
+    def __init__(self, *args, **kwargs) -> None:
+        super().__init__(*args, **kwargs)
+        self._alignment_state = self._alignment_prefix = None
+        self.context_manager = _AlignmentManager(self.context_manager, self)
+
+    def call_Fn_blocks(self, hidden_states, *args, **kwargs):
+        output = super().call_Fn_blocks(hidden_states, *args, **kwargs)
+        self._alignment_prefix = output[0]
+        return output
+
+    def call_Mn_blocks(self, hidden_states, *args, **kwargs):
+        computed, encoder, _ = super().call_Mn_blocks(hidden_states, *args, **kwargs)
+        return computed, encoder, computed.float() - hidden_states.float()
+
+    def forward(self, hidden_states, *args, alignment_cache_state=None, **kwargs):
+        if not isinstance(alignment_cache_state, MiniMaxH3AlignedCacheState) or alignment_cache_state.closed:
+            raise RuntimeError("H3 alignment requires an active request state")
+        if kwargs.get("num_requests", 1) != 1 or kwargs.get("reference_kv_state") is not None:
+            raise ValueError("H3 alignment requires one request without reference-KV reuse")
+        old_state, old_prefix = self._alignment_state, self._alignment_prefix
+        try:
+            self._alignment_state = alignment_cache_state
+            return super().forward(hidden_states, *args, **kwargs)
+        finally:
+            self._alignment_state, self._alignment_prefix = old_state, old_prefix
+
+
+class MiniMaxH3AlignedCachedAdapter(MiniMaxH3CachedAdapter):
+    block_class = MiniMaxH3AlignedCachedBlocks
