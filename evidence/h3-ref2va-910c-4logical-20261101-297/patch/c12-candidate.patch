+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+from datetime import timedelta
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.nn as nn
+
+from tests.helpers.mark import hardware_marks
+from vllm_omni.diffusion.models.minimax_h3 import cache_state_alignment as aligned
+from vllm_omni.diffusion.models.minimax_h3.reference_kv_cache_dit import MiniMaxH3CachedBlocks
+from vllm_omni.platforms import current_omni_platform
+
+pytestmark = [pytest.mark.core_model, pytest.mark.diffusion, *hardware_marks(res={"npu": "A3"}, num_cards=4)]
+
+
+def feature(t, device="cpu", dtype=torch.float32):
+    return torch.tensor([[t, t * t, 5.0]], device=device, dtype=dtype)
+
+
+def history(device="cpu", group=2):
+    state = aligned.MiniMaxH3AlignedCacheState()
+    state.set_groups(torch.tensor([group], device=device))
+    for step in range(3):
+        state.begin_step(step)
+        f = feature(step, device)
+        state.record(f, 2 * f + 3)
+    state.begin_step(3)
+    return state
+
+
+def test_feature_forecast_uses_current_state_and_owns_anchors():
+    state = history()
+    current = feature(2.5)
+    assert state.can_predict(current, parallelized=False)
+    torch.testing.assert_close(state.predict(current), 3 * current + 3, atol=0.01, rtol=0)
+    saved = [f.clone() for f, _ in state.history]
+    current.fill_(99)
+    assert all(torch.equal(a, b) for a, (b, _) in zip(saved, state.history))
+    state.close()
+    assert state.closed and not state.history and state.groups is None and state.coefficients is None
+
+
+@pytest.mark.parametrize("kind", ["missing", "out_of_span", "unstable", "nonfinite"])
+def test_invalid_prediction_is_vetoed(kind):
+    state = history()
+    current = feature(2.5)
+    if kind == "missing":
+        state.history.pop()
+    elif kind == "out_of_span":
+        current[0, 2] = 100
+    elif kind == "unstable":
+        current = feature(30)
+    else:
+        current[0, 0] = float("nan")
+    assert not state.can_predict(current, parallelized=False)
+    assert state.vetoes == 1
+
+
+def test_structural_groups_preserve_reference_and_exclude_padding():
+    state = aligned.MiniMaxH3AlignedCacheState()
+    branch = SimpleNamespace(
+        seq_len=7,
+        device="cpu",
+        text_pos_dev=torch.tensor([0]),
+        img_pos_dev=torch.tensor([1, 2]),
+        update_mask_dev=torch.tensor([False, True]),
+        audio_pos_dev=torch.tensor([3, 4]),
+        audio_update_mask_dev=torch.tensor([False, True]),
+    )
+    state.configure(branch)
+    assert state.groups.tolist() == [0, 1, 2, 3, 4, -1, -1]
+    for step in range(3):
+        state.begin_step(step)
+        f = feature(step).expand(7, -1).clone()
+        state.record(f, 2 * f + 3)
+    state.begin_step(3)
+    current = feature(2.5).expand(7, -1).clone()
+    current[5:] = 1000
+    assert state.can_predict(current, parallelized=False)
+    torch.testing.assert_close(state.predict(current)[:5], (3 * current + 3)[:5], atol=0.01, rtol=0)
+
+
+@pytest.mark.parametrize("failure", [False, True])
+def test_wrapper_releases_request_and_does_not_forward_private_state(monkeypatch, failure):
+    wrapper = object.__new__(aligned.MiniMaxH3AlignedCachedBlocks)
+    nn.Module.__init__(wrapper)
+    wrapper._alignment_state = wrapper._alignment_prefix = None
+    state = history()
+
+    def parent(self, hidden, **kwargs):
+        assert "alignment_cache_state" not in kwargs and self._alignment_state is state
+        if failure:
+            raise RuntimeError("test failure")
+        return hidden
+
+    monkeypatch.setattr(MiniMaxH3CachedBlocks, "forward", parent)
+    if failure:
+        with pytest.raises(RuntimeError, match="test failure"):
+            wrapper.forward(feature(2.5), alignment_cache_state=state)
+    else:
+        wrapper.forward(feature(2.5), alignment_cache_state=state)
+    assert wrapper._alignment_state is None and wrapper._alignment_prefix is None
+
+
+def test_default_and_unsupported_configuration():
+    config = SimpleNamespace(cache_config={})
+    assert not aligned.alignment_cache_enabled(config)
+    config.cache_config = {"minimax_h3_alignment_cache": True}
+    with pytest.raises(ValueError):
+        aligned.alignment_cache_enabled(config)
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires native Ascend execution")
+def test_native_bf16_and_actual_cache_wrapper():
+    from cache_dit import DBCacheConfig, ForwardPattern
+    from cache_dit.caching.cache_contexts.cache_manager import CachedContextManager
+
+    class Block(nn.Module):
+        def __init__(self, prefix=False):
+            super().__init__()
+            self.prefix = prefix
+            self.calls = 0
+
+        def forward(self, hidden, **kwargs):
+            self.calls += 1
+            return hidden + (0.125 if self.prefix else 1.0)
+
+    manager = CachedContextManager()
+    context = manager.new_context(
+        name="h3-alignment-native",
+        cache_config=DBCacheConfig(
+            Fn_compute_blocks=1,
+            Bn_compute_blocks=0,
+            max_warmup_steps=4,
+            num_inference_steps=5,
+            residual_diff_threshold=0.15,
+            max_continuous_cached_steps=4,
+        ),
+    )
+    blocks = nn.ModuleList([Block(True), Block(), Block()])
+    wrapper = aligned.MiniMaxH3AlignedCachedBlocks(
+        blocks,
+        forward_pattern=ForwardPattern.Pattern_3,
+        check_forward_pattern=False,
+        cache_prefix="blocks",
+        cache_context=context,
+        context_manager=manager,
+    )
+    state = aligned.MiniMaxH3AlignedCacheState()
+    state.set_groups(torch.tensor([2], device="npu"))
+    for step in range(5):
+        state.begin_step(step)
+        f = torch.ones(1, 3, dtype=torch.bfloat16, device="npu")
+        output = wrapper(f, alignment_cache_state=state)
+        assert torch.equal(output, f + 2.125) and output.dtype == f.dtype
+        assert wrapper._alignment_state is None and wrapper._alignment_prefix is None
+    assert state.computed == 4 and state.predicted == 1
+    assert blocks[1].calls == 4 and blocks[0].calls == 5
+    state.close()
+
+
+def _distributed_worker(rank):
+    import torch_npu  # noqa: F401
+
+    torch.npu.set_device(rank)
+    dist.init_process_group(
+        "hccl", init_method="tcp://127.0.0.1:29597", rank=rank, world_size=4, timeout=timedelta(seconds=120)
+    )
+    try:
+        # Only rank3 has audio; all ranks have empty reference-audio groups.
+        state = history(device=f"npu:{rank}", group=[0, 1, 2, 4][rank])
+        current = feature(2.5, device=f"npu:{rank}", dtype=torch.bfloat16)
+        assert state.can_predict(current, parallelized=True)
+        torch.testing.assert_close(state.predict(current).float(), 3 * current.float() + 3, atol=0.0625, rtol=0)
+        state.close()
+        assert state.groups is None and not state.history
+        dist.barrier()
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires four native Ascend devices")
+def test_native_four_rank_empty_group_collectives():
+    torch.multiprocessing.spawn(_distributed_worker, nprocs=4, join=True)
+
+
+@pytest.mark.parametrize("failure", ["success", "model", "cancel"])
+def test_denoise_request_closes_history_on_all_exit_paths(monkeypatch, failure):
+    from vllm_omni.diffusion.models.minimax_h3 import denoise_loop as loop
+
+    monkeypatch.setattr(loop.current_omni_platform, "is_npu", lambda: False)
+    monkeypatch.setattr(loop, "minimax_h3_publish_denoise_progress", lambda *args: None)
+    state = aligned.MiniMaxH3AlignedCacheState()
+
+    class Model:
+        def create_alignment_cache_state(self):
+            return state
+
+        def __call__(self, **kwargs):
+            assert kwargs["alignment_cache_state"] is state
+            state.record(torch.ones(2, 1), torch.ones(2, 1))
+            if failure == "model":
+                raise RuntimeError("model failed")
+            return torch.zeros(1, 96), torch.zeros(1, 32)
+
+    class Branch:
+        seq_len = 2
+        device = torch.device("cpu")
+        text_pos_dev = torch.tensor([], dtype=torch.long)
+        img_pos_dev = torch.tensor([0])
+        audio_pos_dev = torch.tensor([1])
+        update_mask = torch.ones(1, dtype=torch.bool)
+        update_mask_dev = update_mask
+        audio_update_mask_dev = update_mask
+        locked_audio_rows = None
+
+        def forward_kwargs(self, **kwargs):
+            return {}
+
+    monkeypatch.setattr(
+        loop,
+        "minimax_h3_prepare_denoise_rows",
+        lambda **kwargs: (kwargs["initial_video_rows"], kwargs["initial_audio_rows"], None, None),
+    )
+
+    def cancellation(**kwargs):
+        if failure == "cancel":
+            raise RuntimeError("request cancelled")
+
+    monkeypatch.setattr(loop, "check_request_cancellation", cancellation)
+    model = Model()
+    kwargs = dict(
+        model=model,
+        positive=Branch(),
+        initial_video_rows=torch.zeros(1, 96),
+        initial_audio_rows=torch.zeros(1, 32),
+        keyframe_cond_rows=None,
+        sigmas_video=[1.0, 0.0],
+        sigmas_audio=[1.0, 0.0],
+        device=torch.device("cpu"),
+    )
+    if failure == "success":
+        loop.minimax_h3_denoise_loop(**kwargs)
+    else:
+        with pytest.raises(RuntimeError):
+            loop.minimax_h3_denoise_loop(**kwargs)
+    assert state.closed and not state.history
+    assert model._alignment_cache_stats["computed"] == (0 if failure == "cancel" else 1)
