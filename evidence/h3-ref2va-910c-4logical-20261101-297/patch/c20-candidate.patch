+import math
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.helpers.mark import hardware_marks
+from vllm_omni.diffusion.models.minimax_h3.attention import flash_h3 as flash
+from vllm_omni.platforms import current_omni_platform
+
+pytestmark = [pytest.mark.core_model, pytest.mark.diffusion, *hardware_marks(res={"npu": "A3"}, num_cards=1)]
+
+
+def dense(query, key, value, scale):
+    q, k, v = [x.transpose(1, 2).float() for x in (query, key, value)]
+    return (torch.softmax(q @ k.transpose(-2, -1) * scale, dim=-1) @ v).transpose(1, 2).to(query.dtype)
+
+
+def expected_video(q, k, v, scale, frames, height, width, prefix):
+    rows = height * width
+    result = torch.zeros_like(q)
+    result[:, :prefix] = dense(q[:, :prefix], k, v, scale)
+    key_parts, value_parts = [k[:, :prefix]], [v[:, :prefix]]
+    variances = [torch.zeros(1, prefix, k.shape[2])]
+    for f in range(frames):
+        for y in range(0, height, 3):
+            for x in range(0, width, 3):
+                indices = [prefix + f * rows + (y + dy) * width + x + dx for dy in range(3) for dx in range(3)]
+                key_parts.append(k[:, indices].float().mean(1, keepdim=True).to(k.dtype))
+                value_parts.append(v[:, indices].float().mean(1, keepdim=True).to(v.dtype))
+                variances.append(k[:, indices].float().var(dim=1, unbiased=False).mean(-1).unsqueeze(1))
+    keys, values = torch.cat(key_parts, 1), torch.cat(value_parts, 1)
+    queries = q[:, prefix : k.shape[1]]
+    logits = queries.transpose(1, 2).float() @ keys.transpose(1, 2).float().transpose(-2, -1) * scale
+    logits[..., prefix:] += math.log(9)
+    norm_sq = queries.transpose(1, 2).float().square().sum(-1, keepdim=True)
+    variance = torch.cat(variances, 1).transpose(1, 2).unsqueeze(2)
+    logits += 0.5 * scale**2 * norm_sq * variance
+    output = torch.softmax(logits, -1) @ values.transpose(1, 2).float()
+    result[:, prefix : k.shape[1]] = output.transpose(1, 2).to(q.dtype)
+    return result
+
+
+def fixture(frames=3, height=3, width=6, prefix=4, heads=2, dim=8, device="cpu"):
+    torch.manual_seed(217)
+    used = prefix + frames * height * width
+    q = torch.randn(1, used + 2, heads, dim, dtype=torch.bfloat16).to(device)
+    k, v = [torch.randn(1, used, heads, dim, dtype=torch.bfloat16).to(device) for _ in range(2)]
+    return q, k, v
+
+
+@pytest.mark.parametrize("frames,height,width,prefix", [(2, 3, 3, 0), (3, 3, 6, 4), (5, 6, 3, 2)])
+def test_pooling_matches_independent_weighted_key_reference(monkeypatch, frames, height, width, prefix):
+    q, k, v = fixture(frames, height, width, prefix)
+    saved = [x.clone() for x in (q, k, v)]
+    monkeypatch.setattr(flash, "_prefix_bnsd", dense)
+    actual = flash._video_variance_pool_bnsd(
+        q, k, v, 0.25, target_start=prefix, frames=frames, height=height, width=width
+    )
+    expected = expected_video(q, k, v, 0.25, frames, height, width, prefix)
+    torch.testing.assert_close(actual.float(), expected.float(), atol=0.0078125, rtol=0.02)
+    assert torch.count_nonzero(actual[:, k.shape[1] :]) == 0
+    assert all(torch.equal(a, b) for a, b in zip(saved, (q, k, v)))
+
+
+def test_nine_identical_keys_retain_original_softmax_mass(monkeypatch):
+    q, k, v = fixture(height=3, width=3)
+    for tensor in (k, v):
+        for f in range(3):
+            tensor[:, 4 + f * 9 : 4 + (f + 1) * 9] = tensor[:, 4 + f * 9 : 5 + f * 9].clone()
+    monkeypatch.setattr(flash, "_prefix_bnsd", dense)
+    actual = flash._video_variance_pool_bnsd(q, k, v, 0.25, target_start=4, frames=3, height=3, width=3)
+    expected = dense(q[:, : k.shape[1]], k, v, 0.25)
+    torch.testing.assert_close(actual[:, : k.shape[1]].float(), expected.float(), atol=0.0078125, rtol=0.02)
+
+
+@pytest.mark.parametrize("kind", ["height", "width", "tail", "frames", "batch", "query", "scale"])
+def test_invalid_requested_geometry_raises(kind):
+    q, k, v = fixture()
+    kwargs = dict(target_start=4, frames=3, height=3, width=6, scale=0.25)
+    if kind in ("height", "width"):
+        kwargs[kind] += 1
+    elif kind == "tail":
+        kwargs["target_start"] += 1
+    elif kind == "frames":
+        kwargs["frames"] = 1
+    elif kind == "batch":
+        q, k, v = [tensor.expand(2, -1, -1, -1) for tensor in (q, k, v)]
+    elif kind == "query":
+        q = q[:, :2]
+    else:
+        kwargs["scale"] = 0
+    with pytest.raises(ValueError, match="pooled context"):
+        flash._video_variance_pool_bnsd(q, k, v, **kwargs)
+
+
+def test_fixed_progress_and_default_off(monkeypatch):
+    monkeypatch.setenv("H3_VIDEO_VARIANCE_POOL", "3x3-variance")
+    for step in range(50):
+        monkeypatch.setattr(
+            flash, "get_forward_context", lambda: SimpleNamespace(denoise_step_idx=step, total_denoise_steps=50)
+        )
+        assert flash._use_video_variance_pool() == (step not in (0, 49))
+    monkeypatch.setattr(
+        flash, "get_forward_context", lambda: SimpleNamespace(denoise_step_idx=None, total_denoise_steps=50)
+    )
+    with pytest.raises(ValueError, match="published"):
+        flash._use_video_variance_pool()
+    monkeypatch.setenv("H3_VIDEO_VARIANCE_POOL", "other")
+    with pytest.raises(ValueError, match="3x3-variance"):
+        flash._use_video_variance_pool()
+    monkeypatch.delenv("H3_VIDEO_VARIANCE_POOL")
+    monkeypatch.setenv("MINDIE_SD_FA_TYPE", "fused_attn_score")
+    impl = object.__new__(flash.MiniMaxH3FlashAttentionImpl)
+    impl.causal, impl.softmax_scale = False, 0.25
+    impl._resolve_packed_seq_npu = lambda *args: ([4096], [4093])
+    monkeypatch.setattr(flash, "get_forward_context", lambda: pytest.fail("default path read experimental progress"))
+    monkeypatch.setattr(flash, "_prefix_bnsd", lambda q, k, v, scale: q)
+    q = torch.ones(1, 4096, 1, 8, dtype=torch.bfloat16)
+    from vllm_omni.diffusion.attention.backends.abstract import AttentionMetadata
+
+    assert impl.forward_fa_npu(q, q, q, AttentionMetadata(extra={"npu_attn_varlen": True})) is q
+
+
+@pytest.mark.parametrize("step", [0, 1, 49])
+def test_requested_dispatch_uses_published_grid(monkeypatch, step):
+    from vllm_omni.diffusion.attention.backends.abstract import AttentionMetadata, VideoTokenLayout, VideoTokenSpan
+
+    monkeypatch.setenv("MINDIE_SD_FA_TYPE", "fused_attn_score")
+    monkeypatch.setenv("H3_VIDEO_VARIANCE_POOL", "3x3-variance")
+    monkeypatch.setattr(
+        flash, "get_forward_context", lambda: SimpleNamespace(denoise_step_idx=step, total_denoise_steps=50)
+    )
+    impl = object.__new__(flash.MiniMaxH3FlashAttentionImpl)
+    impl.causal, impl.softmax_scale = False, 0.25
+    impl._resolve_packed_seq_npu = lambda *args: ([4096], [4096])
+    q = torch.ones(1, 4192, 1, 8, dtype=torch.bfloat16)
+    metadata = AttentionMetadata(
+        extra={"npu_attn_varlen": True},
+        video_layout=VideoTokenLayout(
+            used_len=4096, video_spans=(VideoTokenSpan(start=64, latent_grid=(4, 24, 42), role="target"),)
+        ),
+    )
+    calls = []
+    monkeypatch.setattr(flash, "_prefix_bnsd", lambda *args: calls.append("dense") or q)
+
+    def pooled(query, key, value, scale, **kwargs):
+        assert key.shape[1] == value.shape[1] == 4096
+        assert kwargs == {"target_start": 64, "frames": 4, "height": 24, "width": 42}
+        calls.append("pooled")
+        return q
+
+    monkeypatch.setattr(flash, "_video_variance_pool_bnsd", pooled)
+    assert impl.forward_fa_npu(q, q, q, metadata) is q
+    assert calls == (["dense"] if step in (0, 49) else ["pooled"])
+
+
+def test_requested_unsupported_main_geometry_does_not_fallback(monkeypatch):
+    from vllm_omni.diffusion.attention.backends.abstract import AttentionMetadata
+
+    monkeypatch.setenv("MINDIE_SD_FA_TYPE", "fused_attn_score")
+    monkeypatch.setenv("H3_VIDEO_VARIANCE_POOL", "3x3-variance")
+    impl = object.__new__(flash.MiniMaxH3FlashAttentionImpl)
+    impl.causal = True
+    q = torch.ones(1, 4096, 1, 8, dtype=torch.bfloat16)
+    with pytest.raises(ValueError, match="unsupported"):
+        impl.forward_fa_npu(q, q, q, AttentionMetadata(extra={"npu_attn_varlen": True}))
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires native Ascend FAS")
+def test_native_variance_pool_fas_executes_second_moment_compensation():
+    import torch_npu  # noqa: F401
+
+    q, k, v = fixture(height=6, width=6, heads=14, dim=128, device="npu")
+    actual = flash._video_variance_pool_bnsd(q, k, v, 128**-0.5, target_start=4, frames=3, height=6, width=6)
+    torch.npu.synchronize()
+    assert actual.dtype == torch.bfloat16 and torch.isfinite(actual).all()
+    expected = expected_video(q.cpu(), k.cpu(), v.cpu(), 128**-0.5, 3, 6, 6, 4)
+    torch.testing.assert_close(actual.cpu().float(), expected.float(), atol=0.03125, rtol=0.025)
