 def _prefix_bnsd(query: torch.Tensor, key: torch.Tensor, value: torch.Tensor, scale: float) -> torch.Tensor:
@@ -36,6 +38,78 @@ def _prefix_bnsd(query: torch.Tensor, key: torch.Tensor, value: torch.Tensor, sc
     return output.reshape(batch, heads, rows, dim).transpose(1, 2).contiguous()
 
 
+def _video_variance_pool_bnsd(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    scale: float,
+    *,
+    target_start: int,
+    frames: int,
+    height: int,
+    width: int,
+) -> torch.Tensor:
+    """Share global summaries with isotropic key-variance mass compensation."""
+    rows = height * width
+    if (
+        query.shape[0] != 1
+        or key.shape[0] != 1
+        or value.shape != key.shape
+        or query.shape[2:] != key.shape[2:]
+        or target_start < 0
+        or frames < 2
+        or height < 3
+        or width < 3
+        or height % 3
+        or width % 3
+        or target_start + frames * rows != key.shape[1]
+        or query.shape[1] < key.shape[1]
+        or scale <= 0
+    ):
+        raise ValueError("H3 pooled context requires a final video grid divisible by three")
+    heads, dim = query.shape[2:]
+
+    def pack(tensor: torch.Tensor) -> torch.Tensor:
+        pooled = (
+            tensor[:, target_start:]
+            .reshape(frames, height // 3, 3, width // 3, 3, heads, dim)
+            .float()
+            .mean(dim=(2, 4))
+            .to(tensor.dtype)
+            .reshape(1, frames * rows // 9, heads, dim)
+        )
+        return torch.cat((tensor[:, :target_start], pooled), dim=1)
+
+    output = torch.zeros_like(query)
+    if target_start:
+        output[:, :target_start] = _prefix_bnsd(query[:, :target_start], key, value, scale)
+    video_query = query[:, target_start : key.shape[1]]
+    grouped_key = key[:, target_start:].reshape(frames, height // 3, 3, width // 3, 3, heads, dim).float()
+    variance = grouped_key.var(dim=(2, 4), unbiased=False).mean(dim=-1).reshape(1, frames * rows // 9, heads)
+    query_norm_sq = video_query.float().square().sum(dim=-1)
+    padded_q = torch.nn.functional.pad(video_query, (0, 16))
+    padded_k = torch.nn.functional.pad(pack(key), (0, 16))
+    padded_v = torch.nn.functional.pad(pack(value), (0, 16))
+    padded_q[..., dim] = 1
+    padded_k[:, target_start:, :, dim] = math.log(9) / scale
+    # Isotropic second-moment approximation to the pooled log-partition.
+    padded_q[..., dim + 1] = 0.5 * scale * query_norm_sq
+    padded_k[:, target_start:, :, dim + 1] = variance
+    attended = _prefix_bnsd(padded_q, padded_k, padded_v, scale)[..., :dim]
+    output[:, target_start : key.shape[1]] = attended
+    return output
+
+
+def _use_video_variance_pool() -> bool:
+    if os.environ.get("H3_VIDEO_VARIANCE_POOL") != "3x3-variance":
+        raise ValueError("The experimental H3 pooled-context profile requires 3x3-variance")
+    context = get_forward_context()
+    step, total = context.denoise_step_idx, context.total_denoise_steps
+    if total != 50 or step is None or not 0 <= step < 50:
+        raise ValueError("The experimental H3 pooled-context profile requires published 50-step progress")
+    return step not in (0, 49)
+
