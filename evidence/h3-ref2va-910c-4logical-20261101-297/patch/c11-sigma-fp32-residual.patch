+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+"""Opt-in, request-owned residual forecasting on H3's two sigma clocks."""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Mapping
+from typing import Any
+from weakref import ref
+
+import torch
+
+from .reference_kv_cache_dit import MiniMaxH3CachedAdapter, MiniMaxH3CachedBlocks
+
+
+def sigma_cache_enabled(config: Any) -> bool:
+    cache = getattr(config, "cache_config", {})
+    enabled = (
+        cache.get("minimax_h3_sigma_cache", False)
+        if isinstance(cache, Mapping)
+        else getattr(cache, "minimax_h3_sigma_cache", False)
+    )
+    if type(enabled) is not bool:
+        raise ValueError("minimax_h3_sigma_cache must be a boolean")
+    if not enabled:
+        return False
+    parallel = getattr(config, "parallel_config", None)
+    if (
+        getattr(config, "task_type", None) != "ref2va"
+        or getattr(config, "cache_backend", None) != "cache_dit"
+        or getattr(config, "kv_offload_config", None) is not None
+        or (getattr(parallel, "data_parallel_size", 1) or 1) != 1
+        or (getattr(parallel, "cfg_parallel_size", 1) or 1) != 1
+    ):
+        raise ValueError("H3 sigma cache requires Ref2VA Cache-DiT, DP1/CFG1 and no reference-KV cache")
+    taylor = cache.get("enable_taylorseer", False) if isinstance(cache, Mapping) else cache.enable_taylorseer
+    if taylor:
+        raise ValueError("H3 sigma cache replaces TaylorSeer; disable enable_taylorseer")
+    return True
+
+
+def _quadratic_weights(anchors: list[float], target: float) -> tuple[float, ...] | None:
+    if len(anchors) != 3 or not all(math.isfinite(x) for x in [*anchors, target]):
+        return None
+    if not anchors[0] > anchors[1] > anchors[2] > target:
+        return None
+    weights = []
+    for i, anchor in enumerate(anchors):
+        weight = 1.0
+        for j, other in enumerate(anchors):
+            if i != j:
+                weight *= (target - other) / (anchor - other)
+        weights.append(weight)
+    # A host-only veto: all SP ranks have the same clocks and anchor steps.
+    if not all(math.isfinite(x) for x in weights) or sum(abs(x) for x in weights) > 64.0:
+        return None
+    return tuple(weights)
+
+
+class MiniMaxH3SigmaCacheState:
+    """Three real middle-residual anchors, owned by one denoise request."""
+
+    def __init__(self) -> None:
+        self.step = -1
+        self.sigmas = (1.0, 1.0)
+        self.history: list[tuple[tuple[float, float], torch.Tensor]] = []
+        self.closed = False
+        self.computed = 0
+        self.predicted = 0
+        self.history_vetoes = 0
+
+    def begin_step(self, step: int, video_sigma: float, audio_sigma: float) -> None:
+        if self.closed or step != self.step + 1:
+            raise RuntimeError("H3 sigma cache requires consecutive steps in an open request")
+        sigmas = (float(video_sigma), float(audio_sigma))
+        if not all(math.isfinite(x) for x in sigmas):
+            raise ValueError("H3 sigma cache requires finite sigma clocks")
+        if self.step >= 0 and not all(x < old for x, old in zip(sigmas, self.sigmas)):
+            raise ValueError("H3 sigma cache requires descending sigma clocks")
+        self.step, self.sigmas = step, sigmas
+
+    def _weights(self) -> tuple[tuple[float, ...], tuple[float, ...]] | None:
+        if self.closed or len(self.history) != 3:
+            return None
+        video = _quadratic_weights([clock[0] for clock, _ in self.history], self.sigmas[0])
+        audio = _quadratic_weights([clock[1] for clock, _ in self.history], self.sigmas[1])
+        return None if video is None or audio is None else (video, audio)
+
+    def can_predict(self, current: torch.Tensor) -> bool:
+        if self._weights() is None:
+            self.history_vetoes += 1
+            return False
+        if any(tensor.shape != current.shape or tensor.device != current.device for _, tensor in self.history):
+            self.history.clear()
+            self.history_vetoes += 1
+            return False
+        return True
+
+    def record(self, residual: torch.Tensor) -> None:
+        if self.closed or self.step < 0 or residual.ndim != 2:
+            raise RuntimeError("H3 sigma cache requires an open step and a two-dimensional residual")
+        if self.history and self.history[-1][0] == self.sigmas:
+            raise RuntimeError("H3 sigma cache received duplicate middle-block residuals")
+        # Own the anchor: neither Cache-DiT nor the model may mutate our history.
+        self.history.append((self.sigmas, residual.detach().clone()))
+        del self.history[:-3]
+        self.computed += 1
+
+    def predict(self, combined_indices: torch.Tensor) -> torch.Tensor:
+        weights = self._weights()
+        if weights is None:
+            raise RuntimeError("H3 sigma cache cannot forecast without three stable anchors")
+        last = self.history[-1][1]
+        if combined_indices.ndim != 1 or combined_indices.shape[0] != last.shape[0]:
+            raise ValueError("H3 sigma cache requires one modality index per local residual row")
+        if combined_indices.device != last.device:
+            raise ValueError("H3 sigma cache modality and residual devices must match")
+        audio_rows = combined_indices.remainder(3).eq(2).unsqueeze(-1)
+        output = torch.zeros_like(last, dtype=torch.float32)
+        for i, (_, residual) in enumerate(self.history):
+            coefficient = torch.where(audio_rows, weights[1][i], weights[0][i])
+            output.add_(residual.float() * coefficient)
+        self.predicted += 1
+        return output
+
+    def stats(self) -> dict[str, int]:
+        return {"computed": self.computed, "predicted": self.predicted, "history_vetoes": self.history_vetoes}
+
+    def close(self) -> None:
+        self.history.clear()
+        self.closed = True
+
+
+class _SigmaCacheManager:
+    def __init__(self, manager: Any, owner: MiniMaxH3SigmaCachedBlocks) -> None:
+        self._manager = manager
+        self._owner = ref(owner)
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._manager, name)
+
+    def _state(self) -> MiniMaxH3SigmaCacheState:
+        owner = self._owner()
+        if owner is None or owner._sigma_state is None:
+            raise RuntimeError("H3 sigma cache manager has no active request")
+        return owner._sigma_state
+
+    def can_cache(self, states_tensor: torch.Tensor, *args, **kwargs) -> bool:
+        allowed = self._manager.can_cache(states_tensor, *args, **kwargs)
+        return allowed and self._state().can_predict(states_tensor)
+
+    def set_Bn_buffer(self, buffer: torch.Tensor, prefix: str = "Bn") -> None:
+        if not self._manager.is_cache_residual():
+            raise ValueError("H3 sigma cache requires middle-block residual caching")
+        self._state().record(buffer)
+        self._manager.set_Bn_buffer(buffer, prefix=prefix)
+
+    def apply_cache(self, hidden_states: torch.Tensor, encoder_hidden_states=None, **kwargs):
+        if encoder_hidden_states is not None or not self._manager.is_cache_residual():
+            raise ValueError("H3 sigma cache supports only the packed H3 residual stream")
+        owner = self._owner()
+        if owner is None or owner._sigma_indices is None:
+            raise RuntimeError("H3 sigma cache has no active modality layout")
+        prediction = self._state().predict(owner._sigma_indices)
+        output = (prediction + hidden_states.float()).to(hidden_states.dtype)
+        return output.contiguous(), None
+
+
+class MiniMaxH3SigmaCachedBlocks(MiniMaxH3CachedBlocks):
+    def __init__(self, *args, **kwargs) -> None:
+        super().__init__(*args, **kwargs)
+        self._sigma_state = None
+        self._sigma_indices = None
+        self.context_manager = _SigmaCacheManager(self.context_manager, self)
+
+    def call_Mn_blocks(self, hidden_states: torch.Tensor, *args, **kwargs):
+        computed, encoder, _ = super().call_Mn_blocks(hidden_states, *args, **kwargs)
+        # Fit the exact difference of the computed BF16 endpoints. Reconstruct
+        # in FP32 and cast once so downstream blocks retain their input dtype.
+        residual = computed.float() - hidden_states.float()
+        return computed, encoder, residual
+
