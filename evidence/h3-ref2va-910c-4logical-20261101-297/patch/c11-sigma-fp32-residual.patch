+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn as nn
+
+from tests.helpers.mark import hardware_marks
+from vllm_omni.diffusion.models.minimax_h3 import cache_sigma_prediction as sigma
+from vllm_omni.diffusion.models.minimax_h3.reference_kv_cache_dit import MiniMaxH3CachedBlocks
+from vllm_omni.platforms import current_omni_platform
+
+pytestmark = [pytest.mark.core_model, pytest.mark.diffusion, *hardware_marks(res={"npu": "A3"}, num_cards=1)]
+
+
+def config(**changes):
+    values = dict(
+        cache_config={"minimax_h3_sigma_cache": True, "enable_taylorseer": False},
+        task_type="ref2va",
+        cache_backend="cache_dit",
+        kv_offload_config=None,
+        parallel_config=SimpleNamespace(data_parallel_size=1, cfg_parallel_size=1),
+    )
+    values.update(changes)
+    return SimpleNamespace(**values)
+
+
+def sample(video, audio, *, device="cpu", dtype=torch.float32):
+    return torch.tensor([[1 + 2 * video + video**2], [4 - audio + 3 * audio**2]], device=device, dtype=dtype)
+
+
+def anchored(*, device="cpu", dtype=torch.float32):
+    state = sigma.MiniMaxH3SigmaCacheState()
+    originals = []
+    for step, (video, audio) in enumerate([(1.0, 1.0), (0.9, 0.8), (0.7, 0.5)]):
+        state.begin_step(step, video, audio)
+        residual = sample(video, audio, device=device, dtype=dtype)
+        state.record(residual)
+        originals.append(residual)
+    state.begin_step(3, 0.5, 0.3)
+    return state, originals
+
+
+def test_distinct_nonuniform_clocks_recover_quadratic_and_own_anchors():
+    state, originals = anchored()
+    indices = torch.tensor([0, 17])
+    expected = sample(0.5, 0.3)
+    assert state.can_predict(expected)
+    torch.testing.assert_close(state.predict(indices), expected)
+    saved = [value.clone() for _, value in state.history]
+    originals[-1].fill_(99)
+    assert all(torch.equal(old, value) for old, (_, value) in zip(saved, state.history))
+    torch.testing.assert_close(state.predict(indices), expected)
+    # One shared video clock gives the wrong audio result on this fixture.
+    video_weights = sigma._quadratic_weights([1.0, 0.9, 0.7], 0.5)
+    wrong_audio = sum(weight * value[1] for weight, (_, value) in zip(video_weights, state.history))
+    assert not torch.allclose(wrong_audio, expected[1])
+    assert state.stats() == {"computed": 3, "predicted": 2, "history_vetoes": 0}
+    state.close()
+    assert state.closed and not state.history and not state.can_predict(expected)
+
+
+@pytest.mark.parametrize(
+    "anchors,target",
+    [([1.0, 0.8], 0.7), ([1.0, 0.8, 0.8], 0.7), ([1.0, 0.9, 0.8], 0.1), ([1.0, 0.9, 0.8], float("nan"))],
+)
+def test_unstable_or_insufficient_history_vetoes(anchors, target):
+    assert sigma._quadratic_weights(anchors, target) is None
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"task_type": "t2va"},
+        {"cache_backend": "none"},
+        {"kv_offload_config": {}},
+        {"parallel_config": SimpleNamespace(data_parallel_size=2)},
+        {"cache_config": {"minimax_h3_sigma_cache": 1}},
+        {"cache_config": {"minimax_h3_sigma_cache": True, "enable_taylorseer": True}},
+    ],
+)
+def test_explicit_unsupported_selection_fails(changes):
+    with pytest.raises(ValueError):
+        sigma.sigma_cache_enabled(config(**changes))
+
+
+def test_default_and_dataclass_extra_selection():
+    from vllm_omni.diffusion.data import DiffusionCacheConfig
+
+    assert not sigma.sigma_cache_enabled(config(cache_config={}))
+    cache = DiffusionCacheConfig.from_dict({"minimax_h3_sigma_cache": True})
+    assert sigma.sigma_cache_enabled(config(cache_config=cache))
+    assert sigma.MiniMaxH3SigmaCachedAdapter.block_class is sigma.MiniMaxH3SigmaCachedBlocks
+
+
+def test_parent_denial_and_request_prediction_do_not_mutate_inputs():
+    state, _ = anchored()
+    owner = SimpleOwner(state, torch.tensor([0, 2]))
+    calls = []
+    manager = SimpleNamespace(
+        can_cache=lambda *args, **kwargs: False,
+        is_cache_residual=lambda: True,
+        set_Bn_buffer=lambda *args, **kwargs: calls.append((args, kwargs)),
+    )
+    proxy = sigma._SigmaCacheManager(manager, owner)
+    hidden = torch.ones(2, 1)
+    assert not proxy.can_cache(hidden)
+    assert state.history_vetoes == 0
+    manager.can_cache = lambda *args, **kwargs: True
+    assert proxy.can_cache(hidden)
+    actual, encoder = proxy.apply_cache(hidden, prefix="blocks_Bn_residual")
+    torch.testing.assert_close(actual, sample(0.5, 0.3) + 1)
+    assert encoder is None and torch.equal(hidden, torch.ones_like(hidden))
+    owner._sigma_state = sigma.MiniMaxH3SigmaCacheState()
+    assert not proxy.can_cache(hidden)
+    assert owner._sigma_state.history_vetoes == 1
+
+
+class SimpleOwner:
+    def __init__(self, state, indices):
+        self._sigma_state, self._sigma_indices = state, indices
+
+
+def test_fp32_history_accepts_bf16_prefix_and_preserves_output_dtype():
+    state, _ = anchored()
+    hidden = torch.ones(2, 1, dtype=torch.bfloat16)
+    assert state.can_predict(hidden)
+    owner = SimpleOwner(state, torch.tensor([0, 2]))
+    proxy = sigma._SigmaCacheManager(SimpleNamespace(is_cache_residual=lambda: True), owner)
+    actual, _ = proxy.apply_cache(hidden)
+    assert actual.dtype == hidden.dtype
+    torch.testing.assert_close(actual, (sample(0.5, 0.3) + hidden.float()).to(hidden.dtype))
+    assert all(value.dtype == torch.float32 for _, value in state.history)
+
+
+def test_middle_anchor_retains_unrounded_endpoint_difference(monkeypatch):
+    before = torch.tensor([[0.0712890625]], dtype=torch.bfloat16)
+    computed = torch.tensor([[7.0]], dtype=torch.bfloat16)
+
+    def parent(self, hidden, *args, **kwargs):
+        return computed, None, computed - hidden
+
+    monkeypatch.setattr(MiniMaxH3CachedBlocks, "call_Mn_blocks", parent)
+    wrapper = object.__new__(sigma.MiniMaxH3SigmaCachedBlocks)
+    nn.Module.__init__(wrapper)
+    end, encoder, residual = wrapper.call_Mn_blocks(before)
+    assert end is computed and encoder is None and residual.dtype == torch.float32
+    assert torch.equal(residual, computed.float() - before.float())
+    assert not torch.equal((computed - before).float(), residual)
+    assert torch.equal((residual + before.float()).to(before.dtype), computed)
+
+
+@pytest.mark.parametrize("failure", [False, True])
+def test_wrapper_releases_transient_request_metadata(monkeypatch, failure):
+    wrapper = object.__new__(sigma.MiniMaxH3SigmaCachedBlocks)
+    nn.Module.__init__(wrapper)
+    wrapper._sigma_state, wrapper._sigma_indices = None, None
+    state = sigma.MiniMaxH3SigmaCacheState()
+
+    def parent(self, hidden, *args, **kwargs):
+        assert "sigma_cache_state" not in kwargs
+        assert self._sigma_state is state
+        if failure:
+            raise RuntimeError("block failed")
+        return hidden
+
+    monkeypatch.setattr(MiniMaxH3CachedBlocks, "forward", parent)
+    args = dict(sigma_cache_state=state, combined_indices=torch.tensor([0, 2]))
+    if failure:
+        with pytest.raises(RuntimeError, match="block failed"):
+            wrapper.forward(torch.ones(2, 1), **args)
+    else:
+        wrapper.forward(torch.ones(2, 1), **args)
+    assert wrapper._sigma_state is None and wrapper._sigma_indices is None
+
+
+@pytest.mark.parametrize("failure", ["success", "model", "cancel"])
+def test_denoise_request_closes_history_on_all_exit_paths(monkeypatch, failure):
+    from vllm_omni.diffusion.models.minimax_h3 import denoise_loop as loop
+
+    monkeypatch.setattr(loop.current_omni_platform, "is_npu", lambda: False)
+    monkeypatch.setattr(loop, "minimax_h3_publish_denoise_progress", lambda *args: None)
+    state = sigma.MiniMaxH3SigmaCacheState()
+
+    class Model:
+        def create_sigma_cache_state(self):
+            return state
+
+        def __call__(self, **kwargs):
+            assert kwargs["sigma_cache_state"] is state
+            state.record(torch.ones(2, 1))
+            if failure == "model":
+                raise RuntimeError("model failed")
+            return torch.zeros(1, 96), torch.zeros(1, 32)
+
+    class Branch:
+        update_mask = torch.ones(1, dtype=torch.bool)
+        update_mask_dev = update_mask
+        audio_update_mask_dev = update_mask
+        locked_audio_rows = None
+
+        def forward_kwargs(self, **kwargs):
+            return {}
+
+    monkeypatch.setattr(
+        loop,
+        "minimax_h3_prepare_denoise_rows",
+        lambda **kwargs: (kwargs["initial_video_rows"], kwargs["initial_audio_rows"], None, None),
+    )
+
+    def cancellation(**kwargs):
+        if failure == "cancel":
+            raise RuntimeError("request cancelled")
+
+    monkeypatch.setattr(loop, "check_request_cancellation", cancellation)
+    model = Model()
+    kwargs = dict(
+        model=model,
+        positive=Branch(),
+        initial_video_rows=torch.zeros(1, 96),
+        initial_audio_rows=torch.zeros(1, 32),
+        keyframe_cond_rows=None,
+        sigmas_video=[1.0, 0.0],
+        sigmas_audio=[1.0, 0.0],
+        device=torch.device("cpu"),
+    )
+    if failure == "success":
+        loop.minimax_h3_denoise_loop(**kwargs)
+    else:
+        with pytest.raises(RuntimeError):
+            loop.minimax_h3_denoise_loop(**kwargs)
+    assert state.closed and not state.history
+    assert model._sigma_cache_stats["computed"] == (0 if failure == "cancel" else 1)
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires native Ascend forecasting")
+def test_native_two_clock_forecast_and_input_immutability():
+    device = torch.device(current_omni_platform.device_type)
+    state, originals = anchored(device=device, dtype=torch.bfloat16)
+    indices = torch.tensor([0, 2], device=device)
+    saved = [value.clone() for value in originals]
+    expected = sample(0.5, 0.3, device=device, dtype=torch.bfloat16)
+    assert state.can_predict(expected)
+    actual = state.predict(indices)
+    # BF16 anchor quantization is separate from exact polynomial algebra.
+    torch.testing.assert_close(actual.float(), expected.float(), atol=0.0625, rtol=0)
+    assert all(torch.equal(value, old) for value, old in zip(originals, saved))
+    assert state.stats()["predicted"] == 1
+    state.close()
+    assert not state.history
+
+
+def _native_real_cache_manager(dtype):
+    from cache_dit import DBCacheConfig, ForwardPattern
+    from cache_dit.caching.cache_contexts.cache_manager import CachedContextManager
+
+    class Block(nn.Module):
+        def __init__(self, prefix=False):
+            super().__init__()
+            self.prefix = prefix
+            self.calls = 0
+
+        def forward(self, hidden_states, *, test_sigmas, **kwargs):
+            self.calls += 1
+            return hidden_states + (
+                0.125 if self.prefix else sample(*test_sigmas, device=hidden_states.device, dtype=hidden_states.dtype)
+            )
+
+    manager = CachedContextManager()
+    context = manager.new_context(
+        name="h3-sigma-native",
+        cache_config=DBCacheConfig(
+            Fn_compute_blocks=1,
+            Bn_compute_blocks=0,
+            max_warmup_steps=4,
+            num_inference_steps=5,
+            residual_diff_threshold=0.08,
+            max_continuous_cached_steps=3,
+        ),
+    )
+    blocks = nn.ModuleList([Block(prefix=True), Block(), Block()])
+    wrapper = sigma.MiniMaxH3SigmaCachedBlocks(
+        blocks,
+        forward_pattern=ForwardPattern.Pattern_3,
+        check_forward_pattern=False,
+        cache_prefix="blocks",
+        cache_context=context,
+        context_manager=manager,
+    )
+    device = torch.device(current_omni_platform.device_type)
+    indices = torch.tensor([0, 2], device=device)
+    state = sigma.MiniMaxH3SigmaCacheState()
+    for step, clocks in enumerate([(1.0, 1.0), (0.95, 0.9), (0.85, 0.75), (0.7, 0.55), (0.5, 0.35)]):
+        state.begin_step(step, *clocks)
+        hidden = torch.ones(2, 1, device=device, dtype=dtype)
+        actual = wrapper(hidden, sigma_cache_state=state, combined_indices=indices, test_sigmas=clocks)
+        assert actual.dtype == hidden.dtype
+        assert all(value.dtype == torch.float32 for _, value in state.history)
+        if step < 4:
+            delta = sample(*clocks, device=device, dtype=dtype)
+            expected = hidden + 0.125 + delta + delta
+            torch.testing.assert_close(actual, expected, atol=0, rtol=0)
+        else:
+            # BF16 full-compute endpoints are quantized, so they do not lie
+            # exactly on the analytic polynomial. Fit the real anchors with an
+            # independent FP64 Vandermonde solve rather than ignoring that error.
+            forecast = torch.empty(2, 1, dtype=torch.float64)
+            for row, modality in enumerate((0, 1)):
+                anchors = [clock[modality] for clock, _ in state.history]
+                matrix = torch.tensor([[1, x, x * x] for x in anchors], dtype=torch.float64)
+                values = torch.stack([value[row].cpu().double() for _, value in state.history])
+                coefficients = torch.linalg.solve(matrix, values)
+                target = clocks[modality]
+                forecast[row] = torch.tensor([1, target, target * target], dtype=torch.float64) @ coefficients
+            expected = (hidden.cpu().double() + 0.125 + forecast).to(device=device, dtype=dtype)
+            tolerance = 0.03125 if dtype == torch.bfloat16 else 1e-5
+            torch.testing.assert_close(actual, expected, atol=tolerance, rtol=1e-5)
+        assert wrapper._sigma_state is None and wrapper._sigma_indices is None
+    assert blocks[0].calls == 5 and blocks[1].calls == blocks[2].calls == 4
+    assert state.stats()["computed"] == 4 and state.stats()["predicted"] == 1
+    state.close()
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires native Ascend cached block execution")
+def test_native_real_cache_manager_computes_then_forecasts():
+    _native_real_cache_manager(torch.float32)
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires native BF16 blocks with FP32 residual history")
+def test_native_bf16_blocks_use_fp32_anchors_and_keep_output_dtype():
+    _native_real_cache_manager(torch.bfloat16)
