@@ -0,0 +1,291 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+"""Request-owned, experimental target-video block residuals for H3 Ref2VA."""
+
+from __future__ import annotations
+
+import math
+
+import torch
+
+
+class MiniMaxH3VideoRowCache:
+    """Keep non-video computation dense while reusing video block updates.
+
+    The first experimental profile is deliberately fixed. No state is shared
+    across requests, and every rank retains all attention collectives.
+    """
+
+    def __init__(
+        self,
+        target_positions: torch.Tensor,
+        *,
+        seq_len: int,
+        used_len: int,
+        num_layers: int,
+        pre_gate: bool = False,
+        secant: bool = False,
+    ) -> None:
+        if secant and not pre_gate:
+            raise ValueError("sigma secants require pre-gate outputs")
+        positions = target_positions.detach().cpu().tolist()
+        if not 0 < used_len <= seq_len or not positions or num_layers < 1:
+            raise ValueError("video-row cache requires a nonempty valid packed document")
+        if positions != sorted(set(positions)) or positions[0] < 0 or positions[-1] >= used_len:
+            raise ValueError("target-video positions must be sorted unique valid rows")
+        target_set = set(positions)
+        dense = [i for i in range(used_len) if i not in target_set]
+        if not dense:
+            raise ValueError("video-row cache requires non-video conditioning rows")
+        self.seq_len = seq_len
+        self.used_len = used_len
+        self.num_layers = num_layers
+        self._target_positions = positions
+        self.global_dense_positions = torch.tensor(dense, dtype=torch.long, device=target_positions.device)
+        self.local_dense_positions: torch.Tensor | None = None
+        self.local_video_positions: torch.Tensor | None = None
+        self._local_span: tuple[int, int] | None = None
+        self._deltas: dict[int, torch.Tensor] = {}
+        self.pre_gate = pre_gate
+        self.secant = secant
+        self._sigma: float | None = None
+        self._anchor_sigmas: dict[tuple[str, int], float] = {}
+        self._slope_intervals: dict[tuple[str, int], float] = {}
+        self._slopes: dict[tuple[str, int], torch.Tensor] = {}
+        self._slope_scales: dict[tuple[str, int], torch.Tensor] = {}
+        self.secant_forecasts = 0
+        self._attention_outputs: dict[int, torch.Tensor] = {}
+        self._mlp_outputs: dict[int, torch.Tensor] = {}
+        self._awaiting_mlp_layer: int | None = None
+        self.fresh_attention_gates = 0
+        self.fresh_mlp_gates = 0
+        self._step = -1
+        self._blocks_this_step = 0
+        self.partial = False
+        self.closed = False
+        self.full_steps = 0
+        self.partial_steps = 0
+        self.full_blocks = 0
+        self.partial_blocks = 0
+        self.subset_attention_calls = 0
+        self.subset_query_rows = 0
+        self.omitted_query_rows = 0
+        self.partial_mlp_rows = 0
+        self.peak_cache_bytes = 0
+
+    @staticmethod
+    def is_full_step(step: int) -> bool:
