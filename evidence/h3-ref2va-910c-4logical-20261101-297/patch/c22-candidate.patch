+def state_for_rows(device="cpu", start=0, length=4):
+    state = MiniMaxH3VideoRowCache(torch.tensor([1, 2], device=device), seq_len=4, used_len=3, num_layers=1)
+    state.prepare_local_span(start, length)
+    return state
+
+
+def anchor(state, x):
+    for step in range(5):
+        state.begin_step(step)
+        state.capture(0, x, x + 0.125)
+        state.end_step()
+    state.begin_step(5)
+
