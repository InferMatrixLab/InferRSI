+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+import pytest
+import torch
+
+from tests.diffusion.models.minimax_h3.test_minimax_h3_pre_gate_cache import _native_pre_gate_worker
+from tests.helpers.mark import hardware_marks
+from vllm_omni.diffusion.models.minimax_h3.video_row_cache import MiniMaxH3VideoRowCache
+from vllm_omni.platforms import current_omni_platform
+
+pytestmark = [pytest.mark.core_model, pytest.mark.diffusion, *hardware_marks(res={"npu": "A3"}, num_cards=4)]
+
+
+def state():
+    cache = MiniMaxH3VideoRowCache(
+        torch.tensor([1, 2]), seq_len=4, used_len=3, num_layers=1, pre_gate=True, secant=True
+    )
+    cache.prepare_local_span(0, 4)
+    return cache
+
+
+@pytest.mark.parametrize("sigma", [None, float("nan"), float("inf"), -0.1, 1.1])
+def test_secant_requires_explicit_finite_solver_sigma(sigma):
+    cache = state()
+    with pytest.raises(ValueError, match="finite solver sigma"):
+        cache.begin_step(0, sigma=sigma)
+    cache.close()
+
+
+def test_secant_cannot_select_gated_block_residual():
+    with pytest.raises(ValueError, match="pre-gate"):
+        MiniMaxH3VideoRowCache(torch.tensor([1]), seq_len=4, used_len=3, num_layers=1, secant=True)
+
+
+def test_two_anchor_forecast_follows_sigma_and_preserves_dense_rows():
+    cache = state()
+    for step, sigma, values in [(0, 1.0, [4, -8]), (1, 0.5, [2, -4])]:
+        cache.begin_step(step, sigma=sigma)
+        x = torch.tensor([values] * 4, dtype=torch.bfloat16)
+        for stage in ("attn", "mlp"):
+            cache.pre_gate_output(0, x, stage)
+        cache.end_step()
+    assert all(t.dtype == torch.int8 for t in cache._slopes.values())
+    assert all(t.dtype == torch.float32 for t in cache._slope_scales.values())
+    assert cache.stats()["live_cache_bytes"] == 40
+    cache.begin_step(2, sigma=0.25)
+    current = torch.full((4, 2), 100, dtype=torch.bfloat16)
+    saved = current.clone()
+    for stage in ("attn", "mlp"):
+        out = cache.pre_gate_output(0, current, stage)
+        assert torch.equal(out[1:3], torch.tensor([[1, -2], [1, -2]], dtype=torch.bfloat16))
+        assert torch.equal(out[[0, 3]], current[[0, 3]])
+        out.zero_()
+    cache.end_step()
+    assert torch.equal(current, saved)
+    assert cache.secant_forecasts == 2
+    with pytest.raises(ValueError, match="strictly decreasing"):
+        cache.begin_step(3, sigma=0.25)
+    cache.close()
+    assert cache.stats()["live_cache_bytes"] == 0
+    assert not cache._slopes and not cache._anchor_sigmas
+
+
+def test_linear_trajectory_and_zero_slope_cover_fixed_fifty_steps():
+    cache = state()
+    for step in range(50):
+        cache.begin_step(step, sigma=1 - step / 50)
+        # The first channel drifts; the second channel's exact zero difference
+        # exercises finite scale handling without adding an artificial epsilon.
+        actual = torch.tensor([[1 + step / 8, 2]] * 4, dtype=torch.bfloat16)
+        for stage in ("attn", "mlp"):
+            out = cache.pre_gate_output(0, actual, stage)
+            torch.testing.assert_close(out[1:3].float(), actual[1:3].float(), atol=0.03125, rtol=0)
+        cache.end_step()
+    assert cache.secant_forecasts == 84
+    assert cache.full_steps == 8 and cache.partial_steps == 42
+    cache.close()
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires four native Ascend devices")
+def test_native_four_rank_sigma_secant_subset_attention_and_current_gates():
+    torch.multiprocessing.spawn(_native_pre_gate_worker, args=(True,), nprocs=4, join=True)
