+def test_delta_is_fp32_and_restore_owns_output():
+    state = state_for_rows()
+    x = torch.tensor([[1, 2], [3, 4], [5, 6], [7, 8]], dtype=torch.bfloat16)
+    anchor(state, x)
+    assert state._deltas[0].dtype == torch.float32
+    before = x.clone()
+    output = state.restore(0, x)
+    assert torch.equal(output[1:3], x[1:3] + 0.125)
+    assert torch.equal(output[[0, 3]], x[[0, 3]])
+    output.zero_()
+    assert torch.equal(x, before)
+    state.end_step()
+    state.close()
+    assert state.closed and not state._deltas and state.global_dense_positions.numel() == 0
+
+
+def large_delta_roundtrip(device="cpu"):
+    state = state_for_rows(device=device)
+    x = torch.full((4, 2), 100000, dtype=torch.bfloat16, device=device)
+    expected = -x
+    delta = expected.float() - x.float()
+    assert torch.isfinite(delta).all()
+    assert not torch.isfinite(delta.to(torch.float16)).all()
+    for step in range(5):
+        state.begin_step(step)
+        state.capture(0, x, expected)
+        state.end_step()
+    state.begin_step(5)
+    actual = state.restore(0, x)
+    assert torch.isfinite(actual).all()
+    assert torch.equal(actual[1:3].cpu().view(torch.uint8), expected[1:3].cpu().view(torch.uint8))
+    assert torch.equal(actual[[0, 3]], x[[0, 3]])
+    state.end_step()
+    state.close()
+    assert state.stats()["live_cache_bytes"] == 0
+
