+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+from datetime import timedelta
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.nn as nn
+
+from tests.diffusion.models.minimax_h3.test_minimax_h3_video_row_cache import tiny_block
+from tests.helpers.mark import hardware_marks
+from vllm_omni.diffusion.layers.indexed_modulation import indexed_gate
+from vllm_omni.diffusion.models.minimax_h3.attention.flash_h3 import _prefix_bnsd, _subset_prefix_bnsd
+from vllm_omni.diffusion.models.minimax_h3.video_row_cache import MiniMaxH3VideoRowCache
+from vllm_omni.platforms import current_omni_platform
+
+pytestmark = [pytest.mark.core_model, pytest.mark.diffusion, *hardware_marks(res={"npu": "A3"}, num_cards=4)]
+
+
+def make_state(start=0, length=4):
+    state = MiniMaxH3VideoRowCache(torch.tensor([1, 2]), seq_len=4, used_len=3, num_layers=1, pre_gate=True)
+    state.prepare_local_span(start, length)
+    return state
+
+
+def test_fixed_pre_gate_schedule_storage_and_request_cleanup():
+    state = make_state()
+    x = torch.ones(4, 2, dtype=torch.bfloat16)
+    full = []
+    for step in range(50):
+        state.begin_step(step)
+        if not state.partial:
+            full.append(step)
+        for stage in ("attn", "mlp"):
+            out = state.pre_gate_output(0, x, stage)
+            assert out.dtype == torch.bfloat16
+            if state.partial:
+                state.record_fresh_gate(stage)
+        state.end_step()
+    assert full == [0, 1, 4, 9, 19, 29, 39, 49]
+    assert state.full_blocks == 8 and state.partial_blocks == 42
+    assert state.fresh_attention_gates == state.fresh_mlp_gates == 42
+    assert all(t.dtype == torch.bfloat16 for t in [*state._attention_outputs.values(), *state._mlp_outputs.values()])
+    assert state.stats()["live_cache_bytes"] == 16
+    state.close()
+    assert state.stats()["live_cache_bytes"] == 0 and state.closed
+
+
+@pytest.mark.parametrize("failure", ["missing_mlp", "mlp_first", "gated_capture", "gated_restore"])
+def test_pre_gate_stage_order_cannot_silently_use_block_residual(failure):
+    state = make_state()
+    x = torch.ones(4, 2, dtype=torch.bfloat16)
+    state.begin_step(0)
+    with pytest.raises(RuntimeError):
+        if failure == "missing_mlp":
+            state.pre_gate_output(0, x, "attn")
+            state.end_step()
+        elif failure == "mlp_first":
+            state.pre_gate_output(0, x, "mlp")
+        elif failure == "gated_capture":
+            state.capture(0, x, x)
+        else:
+            state.restore(0, x)
+    state.close()
+
+
+class ConstantMLP(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.rows = []
+
+    def forward(self, x):
+        self.rows.append(x.shape[0])
+        return torch.full_like(x, 3)
+
+
+@pytest.mark.parametrize("start,length", [(0, 4), (1, 2)])
+def test_real_block_reapplies_changed_gates_and_preserves_empty_dense_shards(start, length):
+    state = make_state(start, length)
+    block = tiny_block()
+    gates = [1.0, 1.0]
+    block.adaln_proj = lambda t: (
+        torch.zeros(3, 2),
+        torch.zeros(3, 2),
+        torch.full((3, 2), gates[0]),
+        torch.zeros(3, 2),
+        torch.zeros(3, 2),
+        torch.full((3, 2), gates[1]),
+    )
+    block.attn = lambda x, **kwargs: torch.full_like(x, 2)
+    block.mlp = ConstantMLP()
+    x = torch.ones(length, 2, dtype=torch.bfloat16)
+    kwargs = dict(
+        t_emb=torch.zeros(1),
+        combined_indices=torch.zeros(length, dtype=torch.long),
+        rope_table=None,
+        cu_seqlens=torch.tensor([0, 3, 4], dtype=torch.int32),
+        max_seqlen=3,
+        packed_total=4,
+    )
+    for step in (0, 1):
+        state.begin_step(step)
+        expected = block(x, **kwargs)
+        actual = block(x, video_row_cache=state, **kwargs)
+        assert torch.equal(actual.view(torch.uint8), expected.view(torch.uint8))
+        state.end_step()
+    gates[:] = [0.5, -0.25]
+    current = x * 2
+    saved = current.clone()
+    expected = block(current, **kwargs)
+    block.mlp.rows.clear()
+    state.begin_step(2)
+    actual = block(current, video_row_cache=state, **kwargs)
+    state.end_step()
+    rows = state.local_dense_positions
+    assert block.mlp.rows == ([rows.numel()] if rows.numel() else [])
+    assert torch.equal(
+        actual[: min(length, 3 - start)].view(torch.uint8), expected[: min(length, 3 - start)].view(torch.uint8)
+    )
+    assert torch.equal(
+        actual.index_select(0, state.local_video_positions), torch.full((state.local_video_positions.numel(), 2), 2.25)
+    )
+    assert not torch.equal(
+        actual.index_select(0, state.local_video_positions), current.index_select(0, state.local_video_positions) + 5
+    )
+    assert torch.equal(current, saved)
+    assert state.fresh_attention_gates == state.fresh_mlp_gates == 1
+    state.close()
+
+
+def _native_pre_gate_worker(rank, secant=False):
+    import torch_npu  # noqa: F401
+
+    torch.npu.set_device(rank)
+    dist.init_process_group(
+        "hccl", init_method="tcp://127.0.0.1:29597", rank=rank, world_size=4, timeout=timedelta(seconds=120)
+    )
+    try:
+        torch.manual_seed(219)
+        full = [torch.randn(32, 4, 128, dtype=torch.bfloat16).npu() for _ in range(3)]
+        exchanged = []
+        for tensor in full:
+            local = tensor[rank * 8 : (rank + 1) * 8]
+            send = local.reshape(8, 4, 1, 128).permute(1, 0, 2, 3).contiguous()
+            receive = torch.empty_like(send)
+            dist.all_to_all_single(receive, send)
+            exchanged.append(receive.reshape(1, 32, 1, 128))
+        state = MiniMaxH3VideoRowCache(
+            torch.arange(8, 24, device="npu"), seq_len=32, used_len=30, num_layers=1, pre_gate=True, secant=secant
+        )
+        state.prepare_local_span(rank * 8, 8)
+        x = torch.full((8, 512), 2, dtype=torch.bfloat16, device="npu")
+        for step in (0, 1):
+            state.begin_step(step, sigma=1 - step / 10)
+            state.pre_gate_output(0, torch.full_like(x, 0.5 + (step * 0.25 if secant else 0)), "attn")
+            state.pre_gate_output(0, torch.full_like(x, 0.25 + (step * 0.125 if secant else 0)), "mlp")
+            state.end_step()
+        state.begin_step(2, sigma=0.8)
+        out = _subset_prefix_bnsd(exchanged[0], exchanged[1][:, :30], exchanged[2][:, :30], 128**-0.5, state)
+        send, receive = out.reshape(4, 8, 1, 128).contiguous(), torch.empty_like(out.reshape(4, 8, 1, 128))
+        dist.all_to_all_single(receive, send)
+        local_out = receive.permute(1, 0, 2, 3).reshape(8, 512)
+        expected = _prefix_bnsd(full[0].unsqueeze(0), full[1][:30].unsqueeze(0), full[2][:30].unsqueeze(0), 128**-0.5)[
+            0
+        ].reshape(32, 512)
+        dense = state.local_dense_positions
+        torch.testing.assert_close(
+            local_out.index_select(0, dense).float(),
+            expected[rank * 8 : (rank + 1) * 8].index_select(0, dense).float(),
+            atol=0.03125,
+            rtol=0.02,
+        )
+        attn = state.pre_gate_output(0, local_out, "attn")
+        indices = torch.zeros(8, dtype=torch.long, device="npu")
+        gate = torch.full((1, 512), 0.5, dtype=torch.float32, device="npu")
+        after_attn = indexed_gate(x, gate, attn, indices)
+        state.record_fresh_gate("attn")
+        mlp = state.pre_gate_output(0, torch.zeros_like(x), "mlp")
+        result = indexed_gate(after_attn, gate, mlp, indices)
+        state.record_fresh_gate("mlp")
+        video = state.local_video_positions
+        assert torch.equal(
+            result.index_select(0, video),
+            torch.full((video.numel(), 512), 2.75 if secant else 2.375, dtype=torch.bfloat16, device="npu"),
+        )
+        assert dense.numel() == [8, 0, 0, 6][rank]
+        state.end_step()
+        state.close()
+        assert state.stats()["live_cache_bytes"] == 0
+        torch.npu.synchronize()
+        dist.barrier()
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires four native Ascend devices")
+def test_native_four_rank_pre_gate_subset_attention_and_current_gates():
+    torch.multiprocessing.spawn(_native_pre_gate_worker, nprocs=4, join=True)
