+def _native_worker(rank):
+    import torch_npu  # noqa: F401
+
+    torch.npu.set_device(rank)
+    dist.init_process_group(
+        "hccl", init_method="tcp://127.0.0.1:29597", rank=rank, world_size=4, timeout=timedelta(seconds=120)
+    )
+    try:
+        large_delta_roundtrip(device=f"npu:{rank}")
+        torch.manual_seed(19)
+        full = [torch.randn(32, 4, 128, dtype=torch.bfloat16).npu() for _ in range(3)]
+        exchanged = []
+        for tensor in full:
+            local = tensor[rank * 8 : (rank + 1) * 8]
+            send = local.reshape(8, 4, 1, 128).permute(1, 0, 2, 3).contiguous()
+            receive = torch.empty_like(send)
+            dist.all_to_all_single(receive, send)
+            exchanged.append(receive.reshape(1, 32, 1, 128))
+        state = MiniMaxH3VideoRowCache(torch.arange(8, 24, device="npu"), seq_len=32, used_len=30, num_layers=1)
+        state.prepare_local_span(rank * 8, 8)
+        x = torch.ones(8, 2, dtype=torch.bfloat16, device="npu")
+        anchor(state, x)
+        output = _subset_prefix_bnsd(exchanged[0], exchanged[1][:, :30], exchanged[2][:, :30], 128**-0.5, state)
+        send = output.reshape(4, 8, 1, 128).contiguous()
+        receive = torch.empty_like(send)
+        dist.all_to_all_single(receive, send)
+        local_output = receive.permute(1, 0, 2, 3).reshape(8, 4, 128)
+        expected = _prefix_bnsd(full[0].unsqueeze(0), full[1][:30].unsqueeze(0), full[2][:30].unsqueeze(0), 128**-0.5)[
+            0
+        ]
+        rows = state.local_dense_positions
+        torch.testing.assert_close(
+            local_output.index_select(0, rows).float(),
+            expected[rank * 8 : (rank + 1) * 8].index_select(0, rows).float(),
+            atol=0.03125,
+            rtol=0.02,
+        )
+        assert state.subset_attention_calls == 1 and state.subset_query_rows == 14
+        assert rows.numel() == [8, 0, 0, 6][rank]
+        state.restore(0, x)
+        state.end_step()
+        state.close()
+        torch.npu.synchronize()
+        dist.barrier()
+    finally:
+        dist.destroy_process_group()
+
+
