+@pytest.mark.parametrize("failure", ["success", "model", "cancel"])
+def test_request_state_closed_and_removed_on_every_exit(monkeypatch, failure):
+    from vllm_omni.diffusion.models.minimax_h3 import denoise_loop as loop
+
+    monkeypatch.setenv("H3_VIDEO_ROW_CACHE", "1")
+    monkeypatch.setattr(loop.current_omni_platform, "is_npu", lambda: False)
+    monkeypatch.setattr(loop, "minimax_h3_publish_denoise_progress", lambda *args: None)
+    state = MiniMaxH3VideoRowCache(torch.tensor([1]), seq_len=4, used_len=3, num_layers=1)
+
+    class Model:
+        def create_video_row_cache(self, *args, **kwargs):
+            return state
+
+        def __call__(self, **kwargs):
+            assert kwargs["video_row_cache"] is state
+            if failure == "model":
+                raise RuntimeError("model failed")
+            state.prepare_local_span(0, 4)
+            x = torch.ones(4, 2, dtype=torch.bfloat16)
+            if state.partial:
+                state.restore(0, x)
+            else:
+                state.capture(0, x, x + 0.125)
+            return torch.zeros(2, 96), torch.zeros(1, 32)
+
+    class Branch:
+        task = "ref2va"
+        seq_len = 4
+        used_len = 3
+        img_pos = torch.tensor([0, 1])
+        update_mask = torch.tensor([False, True])
+        update_mask_dev = update_mask
+        audio_update_mask_dev = torch.tensor([True])
+        locked_audio_rows = None
+        static_kwargs = {"video_token_layout": SimpleNamespace(video_spans=[SimpleNamespace(role="target", start=1)])}
+
+        def forward_kwargs(self, **kwargs):
+            return dict(self.static_kwargs)
+
+    monkeypatch.setattr(
+        loop,
+        "minimax_h3_prepare_denoise_rows",
+        lambda **kwargs: (kwargs["initial_video_rows"], kwargs["initial_audio_rows"], torch.zeros(1, 96), None),
+    )
+
+    def cancellation(**kwargs):
+        if failure == "cancel":
+            raise RuntimeError("request cancelled")
+
+    monkeypatch.setattr(loop, "check_request_cancellation", cancellation)
+    branch, model = Branch(), Model()
+    kwargs = dict(
+        model=model,
+        positive=branch,
+        initial_video_rows=torch.zeros(2, 96),
+        initial_audio_rows=torch.zeros(1, 32),
+        keyframe_cond_rows=torch.zeros(1, 96),
+        sigmas_video=[1 - i / 50 for i in range(51)],
+        sigmas_audio=[1 - i / 50 for i in range(51)],
+        device=torch.device("cpu"),
+    )
+    if failure == "success":
+        loop.minimax_h3_denoise_loop(**kwargs)
+        assert state.full_steps == 17 and state.partial_steps == 33
+    else:
+        with pytest.raises(RuntimeError):
+            loop.minimax_h3_denoise_loop(**kwargs)
+    assert state.closed and not state._deltas and "video_row_cache" not in branch.static_kwargs
+    assert model._video_row_cache_stats["closed"]
+
