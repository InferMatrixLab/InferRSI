@@ -0,0 +1,174 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+"""Ref2VA-owned veto for cache hits with a changing audio modality."""
+
+from __future__ import annotations
+
+import math
+from typing import Any
+from weakref import ref
+
+import torch
+import torch.distributed as dist
+
+from .reference_kv_cache_dit import MiniMaxH3CachedAdapter, MiniMaxH3CachedBlocks
+
+_AUDIO_REUSE_LIMIT = 0.04
+
+
+def audio_cache_guard_enabled(config: Any) -> bool:
+    parallel = getattr(config, "parallel_config", None)
+    return (
+        getattr(config, "task_type", None) == "ref2va"
+        and getattr(config, "cache_backend", None) == "cache_dit"
+        and getattr(config, "kv_offload_config", None) is None
+        and (getattr(parallel, "data_parallel_size", 1) or 1) == 1
+        and (getattr(parallel, "cfg_parallel_size", 1) or 1) == 1
+    )
+
+
+def _modality_changes_allow_reuse(
+    previous: torch.Tensor,
+    current: torch.Tensor,
+    combined_indices: torch.Tensor,
+    *,
+    max_seqlen: int,
+    packed_total: int,
+    video_limit: float,
+    parallelized: bool,
+) -> bool:
+    if previous.shape != current.shape or current.ndim != 2:
+        raise ValueError("H3 audio cache guard requires matching [local_rows, hidden] states")
+    if combined_indices.ndim != 1 or combined_indices.shape[0] != current.shape[0]:
+        raise ValueError("H3 audio cache guard requires one modality index per local row")
+    if previous.device != current.device or combined_indices.device != current.device:
+        raise ValueError("H3 audio cache guard state and modality devices must match")
+    if not math.isfinite(video_limit) or video_limit <= 0:
+        return False
+
+    sp_rank, sp_size = 0, 1
+    if dist.is_initialized():
+        from vllm_omni.diffusion.distributed.parallel_state import (
+            get_sequence_parallel_rank,
+            get_sequence_parallel_world_size,
+        )
+
+        sp_rank, sp_size = get_sequence_parallel_rank(), get_sequence_parallel_world_size()
+    rows = current.shape[0]
+    if packed_total != rows * sp_size or not 0 < max_seqlen <= packed_total:
+        raise ValueError("H3 audio cache guard requires equal SP shards and a valid packed prefix")
+
+    # Padding tags were clamped before combined_indices was built. Exclude the
+    # structural suffix using positions rather than interpreting those tags.
+    valid = torch.arange(rows, device=current.device) + sp_rank * rows < max_seqlen
+    modalities = combined_indices.remainder(3)
+    before, after = previous.float(), current.float()
+    delta = (before - after).abs().mean(dim=-1)
+    magnitude = before.abs().mean(dim=-1)
+    scalars = []
+    for modality in (0, 2):  # Video and audio; the parent still checks all tokens.
+        mask = valid & (modalities == modality)
+        scalars.extend(
+            [
+                torch.where(mask, delta, 0.0).sum(),
+                torch.where(mask, magnitude, 0.0).sum(),
+                mask.sum(dtype=torch.float32),
+            ]
+        )
+    totals = torch.stack(scalars)
+    if parallelized:
+        if not dist.is_initialized():
+            raise RuntimeError("Parallel H3 audio cache guard requires an initialized process group")
+        # Every rank participates, including ranks with no local audio rows.
+        # TP replicas duplicate both sums equally, so their ratio is preserved.
+        dist.all_reduce(totals, op=dist.ReduceOp.SUM)
+    values = totals.cpu().tolist()
+    for start, limit in ((0, video_limit), (3, min(video_limit, _AUDIO_REUSE_LIMIT))):
+        numerator, denominator, count = values[start : start + 3]
+        if count == 0:
+            continue
+        if not math.isfinite(numerator) or not math.isfinite(denominator):
+            return False
+        if denominator == 0:
+            if numerator != 0:
+                return False
+        elif numerator / denominator > limit:
+            return False
+    return True
+
+
+class _AudioCacheManager:
+    def __init__(self, manager: Any, owner: MiniMaxH3AudioGuardCachedBlocks) -> None:
+        self._manager = manager
+        self._owner = ref(owner)
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._manager, name)
+
+    def can_cache(self, states_tensor: torch.Tensor, *args, **kwargs) -> bool:
+        allowed = self._manager.can_cache(states_tensor, *args, **kwargs)
+        owner = self._owner()
+        if not allowed or owner is None or owner._audio_guard_bypass:
+            return allowed
+        if args:
+            raise TypeError("H3 audio cache guard expects named cache-decision options")
+        layout = owner._audio_guard_layout
+        if layout is None:
+            raise RuntimeError("H3 audio cache guard has no active block layout")
+        prefix = kwargs.get("prefix", "Fn")
+        previous = self._manager.get_Fn_buffer(prefix)
+        if previous is None:
+            return False
+        threshold = kwargs.get("threshold")
+        if threshold is None or threshold <= 0:
+            threshold = self._manager.get_residual_diff_threshold()
+        owner._audio_guard_checks += 1
+        accepted = _modality_changes_allow_reuse(
+            previous,
+            states_tensor,
+            layout[0],
+            max_seqlen=layout[1],
+            packed_total=layout[2],
+            video_limit=float(threshold),
+            parallelized=kwargs.get("parallelized", False),
+        )
+        owner._audio_guard_vetoes += int(not accepted)
+        return accepted
+
+
+class MiniMaxH3AudioGuardCachedBlocks(MiniMaxH3CachedBlocks):
+    def __init__(self, *args, **kwargs) -> None:
+        super().__init__(*args, **kwargs)
+        self._audio_guard_layout = None
+        self._audio_guard_bypass = False
+        self._audio_guard_checks = 0
+        self._audio_guard_vetoes = 0
+        self.context_manager = _AudioCacheManager(self.context_manager, self)
+
+    def audio_cache_guard_stats(self) -> dict[str, int | float]:
+        """Diagnostic counters for this wrapper's lifetime, not quality metrics."""
+        return {
+            "checks": self._audio_guard_checks,
+            "vetoes": self._audio_guard_vetoes,
+            "audio_reuse_limit": _AUDIO_REUSE_LIMIT,
+        }
+
+    def forward(self, hidden_states: torch.Tensor, *args, **kwargs):
+        old_layout, old_bypass = self._audio_guard_layout, self._audio_guard_bypass
+        try:
+            self._audio_guard_bypass = (
+                kwargs.get("num_requests", 1) != 1 or kwargs.get("reference_kv_state") is not None
+            )
+            self._audio_guard_layout = (
+                None
+                if self._audio_guard_bypass
+                else (kwargs["combined_indices"], kwargs["max_seqlen"], kwargs["packed_total"])
+            )
+            return super().forward(hidden_states, *args, **kwargs)
+        finally:
+            # Do not retain request metadata in a persistent cached model.
+            self._audio_guard_layout, self._audio_guard_bypass = old_layout, old_bypass
+
+
+class MiniMaxH3AudioGuardCachedAdapter(MiniMaxH3CachedAdapter):
+    block_class = MiniMaxH3AudioGuardCachedBlocks
