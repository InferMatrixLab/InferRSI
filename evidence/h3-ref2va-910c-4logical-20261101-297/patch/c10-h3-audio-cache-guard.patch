+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn as nn
+
+from tests.helpers.mark import hardware_marks
+from vllm_omni.diffusion.models.minimax_h3 import cache_audio_guard as guard
+from vllm_omni.diffusion.models.minimax_h3.reference_kv_cache_dit import (
+    MiniMaxH3CachedAdapter,
+    MiniMaxH3CachedBlocks,
+)
+from vllm_omni.platforms import current_omni_platform
+
+pytestmark = [pytest.mark.core_model, pytest.mark.diffusion, *hardware_marks(res={"npu": "A3"}, num_cards=1)]
+
+
+def decision(previous, current, indices, **kwargs):
+    return guard._modality_changes_allow_reuse(
+        previous,
+        current,
+        indices,
+        max_seqlen=kwargs.pop("max_seqlen", current.shape[0]),
+        packed_total=kwargs.pop("packed_total", current.shape[0]),
+        video_limit=kwargs.pop("video_limit", 0.08),
+        parallelized=kwargs.pop("parallelized", False),
+        **kwargs,
+    )
+
+
+def test_audio_change_hidden_by_global_mean_vetoes():
+    before = torch.ones(128, 8)
+    after = before.clone()
+    after[-2:] = 1.3
+    indices = torch.zeros(128, dtype=torch.long)
+    indices[-2:] = 17  # timestep-index5, audio-modality2
+    assert ((before - after).abs().mean() / before.abs().mean()).item() < 0.08
+    assert not decision(before, after, indices)
+    after[-2:] = 1.02
+    assert decision(before, after, indices)
+    assert not decision(before, after, indices, video_limit=0.01)
+
+
+def test_video_change_and_structural_padding():
+    before = torch.ones(8, 4)
+    after = before.clone()
+    indices = torch.tensor([0, 0, 2, 2, 0, 0, 0, 0])
+    after[4:] = float("nan")
+    assert decision(before, after, indices, max_seqlen=4)
+    after[:2] = 1.2
+    assert not decision(before, after, indices, max_seqlen=4)
+
+
+def test_zero_denominator_and_invalid_layout():
+    before = torch.zeros(4, 2)
+    after = before.clone()
+    indices = torch.full((4,), 2)
+    assert decision(before, after, indices)
+    after[0] = 1
+    assert not decision(before, after, indices)
+    with pytest.raises(ValueError, match="valid packed prefix"):
+        decision(before, after, indices, packed_total=5)
+    with pytest.raises(ValueError, match="modality index"):
+        decision(before, after, indices[:2])
+
+
+def test_remote_audio_participates_when_local_rank_has_none(monkeypatch):
+    from vllm_omni.diffusion.distributed import parallel_state
+
+    monkeypatch.setattr(guard.dist, "is_initialized", lambda: True)
+    monkeypatch.setattr(parallel_state, "get_sequence_parallel_rank", lambda: 0)
+    monkeypatch.setattr(parallel_state, "get_sequence_parallel_world_size", lambda: 2)
+    calls = []
+
+    def reduce(values, op):
+        assert op == guard.dist.ReduceOp.SUM
+        calls.append(values.clone())
+        values.add_(torch.tensor([0.0, 2.0, 1.0, 0.8, 2.0, 1.0]))
+
+    monkeypatch.setattr(guard.dist, "all_reduce", reduce)
+    before = torch.ones(2, 8)
+    assert not decision(before, before, torch.zeros(2, dtype=torch.long), packed_total=4, parallelized=True)
+    assert len(calls) == 1 and calls[0][5].item() == 0
+
+
+@pytest.mark.parametrize("change", ["default", "task", "cache", "refkv", "dp", "cfg"])
+def test_adapter_selection_preserves_other_modes(change):
+    config = SimpleNamespace(
+        task_type="ref2va",
+        cache_backend="cache_dit",
+        kv_offload_config=None,
+        parallel_config=SimpleNamespace(data_parallel_size=1, cfg_parallel_size=1),
+    )
+    if change == "task":
+        config.task_type = "t2va"
+    elif change == "cache":
+        config.cache_backend = "none"
+    elif change == "refkv":
+        config.kv_offload_config = {"mode": "on"}
+    elif change == "dp":
+        config.parallel_config.data_parallel_size = 2
+    elif change == "cfg":
+        config.parallel_config.cfg_parallel_size = 2
+    assert guard.audio_cache_guard_enabled(config) == (change == "default")
+    assert MiniMaxH3CachedAdapter.block_class is MiniMaxH3CachedBlocks
+    assert guard.MiniMaxH3AudioGuardCachedAdapter.block_class is guard.MiniMaxH3AudioGuardCachedBlocks
+
+
+def test_parent_denial_does_not_run_guard():
+    class Owner:
+        _audio_guard_bypass = False
+        _audio_guard_layout = None
+        _audio_guard_checks = 0
+        _audio_guard_vetoes = 0
+
+    owner = Owner()
+    proxy = guard._AudioCacheManager(SimpleNamespace(can_cache=lambda *args, **kwargs: False), owner)
+    assert proxy.can_cache(torch.ones(4, 2)) is False
+    assert owner._audio_guard_checks == 0
+
+
+def test_allowed_parent_hit_is_vetoed_without_changing_buffers():
+    class Owner:
+        _audio_guard_bypass = False
+        _audio_guard_checks = 0
+        _audio_guard_vetoes = 0
+
+    previous = torch.ones(128, 8)
+    current = previous.clone()
+    current[-2:] = 1.3
+    indices = torch.zeros(128, dtype=torch.long)
+    indices[-2:] = 2
+    owner = Owner()
+    owner._audio_guard_layout = (indices, 128, 128)
+    manager = SimpleNamespace(
+        can_cache=lambda *args, **kwargs: True,
+        get_Fn_buffer=lambda prefix: previous,
+        get_residual_diff_threshold=lambda: 0.08,
+    )
+    proxy = guard._AudioCacheManager(manager, owner)
+    assert proxy.can_cache(current, prefix="blocks_Fn_residual", parallelized=False) is False
+    assert (owner._audio_guard_checks, owner._audio_guard_vetoes) == (1, 1)
+    current[-2:] = 1.01
+    assert proxy.can_cache(current, prefix="blocks_Fn_residual", parallelized=False) is True
+    assert (owner._audio_guard_checks, owner._audio_guard_vetoes) == (2, 1)
+    assert torch.equal(previous, torch.ones_like(previous))
+    owner._audio_guard_bypass, owner._audio_guard_layout = True, None
+    assert proxy.can_cache(current) is True
+    assert owner._audio_guard_checks == 2
+
+
+@pytest.mark.parametrize("failure", ["metadata", "parent"])
+def test_forward_releases_layout_on_failure(monkeypatch, failure):
+    wrapper = object.__new__(guard.MiniMaxH3AudioGuardCachedBlocks)
+    nn.Module.__init__(wrapper)
+    wrapper._audio_guard_layout, wrapper._audio_guard_bypass = None, False
+
+    def broken(self, *args, **kwargs):
+        raise RuntimeError("parent failed")
+
+    monkeypatch.setattr(MiniMaxH3CachedBlocks, "forward", broken)
+    kwargs = (
+        {}
+        if failure == "metadata"
+        else {"combined_indices": torch.zeros(4, dtype=torch.long), "max_seqlen": 4, "packed_total": 4}
+    )
+    with pytest.raises((KeyError, RuntimeError)):
+        wrapper.forward(torch.ones(4, 2), **kwargs)
+    assert wrapper._audio_guard_layout is None and wrapper._audio_guard_bypass is False
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires native Ascend reductions")
+def test_native_audio_guard_preserves_input_values():
+    device = torch.device(current_omni_platform.device_type)
+    before = torch.ones(128, 64, dtype=torch.bfloat16, device=device)
+    after = before.clone()
+    indices = torch.zeros(128, dtype=torch.long, device=device)
+    indices[-2:] = 2
+    after[-2:] = 1.3
+    saved = [tensor.clone() for tensor in (before, after, indices)]
+    assert not decision(before, after, indices)
+    assert all(torch.equal(x, y) for x, y in zip(saved, (before, after, indices)))
