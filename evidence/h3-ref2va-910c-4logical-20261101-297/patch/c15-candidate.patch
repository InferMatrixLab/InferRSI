+@pytest.mark.parametrize("positions", [[1, 1], [2, 1], [-1], [3]])
+def test_invalid_target_positions_are_rejected(positions):
+    with pytest.raises(ValueError):
+        MiniMaxH3VideoRowCache(torch.tensor(positions), seq_len=4, used_len=3, num_layers=1)
+
