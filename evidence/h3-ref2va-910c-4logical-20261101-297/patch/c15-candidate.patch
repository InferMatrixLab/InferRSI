+@pytest.mark.parametrize("start,length", [(0, 4), (1, 2)])
+def test_real_block_dense_path_and_partial_mlp_empty_rows(start, length):
+    state = state_for_rows(start=start, length=length)
+    block = tiny_block()
+    x = torch.arange(length * 2).reshape(length, 2).to(torch.bfloat16)
+    before = x.clone()
+    kwargs = dict(
+        t_emb=torch.zeros(1),
+        combined_indices=torch.zeros(length, dtype=torch.long),
+        rope_table=None,
+        cu_seqlens=torch.tensor([0, 3, 4], dtype=torch.int32),
+        max_seqlen=3,
+        packed_total=4,
+    )
+    expected = block(x, **kwargs)
+    for step in range(5):
+        state.begin_step(step)
+        actual = block(x, video_row_cache=state, **kwargs)
+        assert torch.equal(actual.view(torch.uint8), expected.view(torch.uint8))
+        state.end_step()
+    block.mlp.rows.clear()
+    state.begin_step(5)
+    actual = block(x, video_row_cache=state, **kwargs)
+    state.end_step()
+    rows = state.local_dense_positions
+    assert block.mlp.rows == ([rows.numel()] if rows.numel() else [])
+    assert torch.equal(actual.index_select(0, rows), expected.index_select(0, rows))
+    assert torch.equal(x, before)
+
