new file mode 100644
index 0000000..f8437f7
--- /dev/null
+++ b/vllm_omni/diffusion/models/minimax_h3/video_row_cache.py
@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+"""Request-owned, experimental target-video block residuals for H3 Ref2VA."""
+
+from __future__ import annotations
+
+import torch
+
+
+class MiniMaxH3VideoRowCache:
+    """Keep non-video computation dense while reusing video block updates.
+
+    The first experimental profile is deliberately fixed. No state is shared
+    across requests, and every rank retains all attention collectives.
+    """
+
+    def __init__(self, target_positions: torch.Tensor, *, seq_len: int, used_len: int, num_layers: int) -> None:
+        positions = target_positions.detach().cpu().tolist()
+        if not 0 < used_len <= seq_len or not positions or num_layers < 1:
+            raise ValueError("video-row cache requires a nonempty valid packed document")
+        if positions != sorted(set(positions)) or positions[0] < 0 or positions[-1] >= used_len:
+            raise ValueError("target-video positions must be sorted unique valid rows")
+        target_set = set(positions)
+        dense = [i for i in range(used_len) if i not in target_set]
+        if not dense:
+            raise ValueError("video-row cache requires non-video conditioning rows")
+        self.seq_len = seq_len
+        self.used_len = used_len
+        self.num_layers = num_layers
+        self._target_positions = positions
+        self.global_dense_positions = torch.tensor(dense, dtype=torch.long, device=target_positions.device)
+        self.local_dense_positions: torch.Tensor | None = None
+        self.local_video_positions: torch.Tensor | None = None
+        self._local_span: tuple[int, int] | None = None
+        self._deltas: dict[int, torch.Tensor] = {}
+        self._step = -1
+        self._blocks_this_step = 0
+        self.partial = False
+        self.closed = False
+        self.full_steps = 0
+        self.partial_steps = 0
+        self.full_blocks = 0
+        self.partial_blocks = 0
+        self.subset_attention_calls = 0
+        self.subset_query_rows = 0
+        self.omitted_query_rows = 0
+        self.partial_mlp_rows = 0
+        self.cache_bytes = 0
+
+    @staticmethod
+    def is_full_step(step: int) -> bool:
+        if not 0 <= step < 50:
+            raise ValueError("the video-row cache profile requires 50 steps")
+        return step < 4 or step >= 46 or (step - 4) % 5 == 0
+
+    def begin_step(self, step: int) -> None:
+        if self.closed or step != self._step + 1:
+            raise RuntimeError("video-row cache step order changed")
+        if self._step >= 0 and self._blocks_this_step != self.num_layers:
+            raise RuntimeError("previous video-row cache step is incomplete")
+        self.partial = not self.is_full_step(step)
+        if self.partial and len(self._deltas) != self.num_layers:
+            raise RuntimeError("partial video step has no complete dense anchor")
+        self._step = step
+        self._blocks_this_step = 0
+        if self.partial:
+            self.partial_steps += 1
+        else:
+            self.full_steps += 1
+
+    def prepare_local_span(self, start: int, length: int) -> None:
+        if self.closed or start < 0 or length < 1 or start + length > self.seq_len:
+            raise ValueError("invalid local packed span")
+        if self._local_span is not None:
+            if self._local_span != (start, length):
+                raise RuntimeError("video-row cache local ownership changed")
+            return
+        device = self.global_dense_positions.device
+        target = set(self._target_positions)
+        self.local_video_positions = torch.tensor(
+            [i - start for i in self._target_positions if start <= i < start + length], dtype=torch.long, device=device
+        )
+        self.local_dense_positions = torch.tensor(
+            [i - start for i in range(start, min(start + length, self.used_len)) if i not in target],
+            dtype=torch.long,
+            device=device,
+        )
+        self._local_span = (start, length)
+
+    def _visit(self, layer: int, x: torch.Tensor) -> None:
+        if self.closed or self._step < 0 or layer != self._blocks_this_step:
+            raise RuntimeError("video-row cache block order changed")
+        if self._local_span is None or x.shape[0] != self._local_span[1] or x.dtype != torch.bfloat16:
+            raise ValueError("video-row cache requires the prepared BF16 row shard")
+        self._blocks_this_step += 1
+
+    def capture(self, layer: int, x: torch.Tensor, output: torch.Tensor) -> None:
+        if self.partial:
+            raise RuntimeError("cannot replace the dense anchor during a partial step")
+        self._visit(layer, x)
+        rows = self.local_video_positions
+        assert rows is not None
+        self._deltas[layer] = (output.index_select(0, rows).float() - x.index_select(0, rows).float()).to(torch.float16)
+        self.cache_bytes = sum(t.numel() * t.element_size() for t in self._deltas.values())
+        self.full_blocks += 1
+
+    def restore(self, layer: int, x: torch.Tensor) -> torch.Tensor:
+        if not self.partial:
+            raise RuntimeError("cannot reuse a video residual on a full step")
+        self._visit(layer, x)
+        rows = self.local_video_positions
+        assert rows is not None
+        # This copy owns the returned full shard, preserving caller input and
+        # unused padding while fresh non-video rows are filled by the block.
+        output = x.clone()
+        if rows.numel():
+            output.index_copy_(0, rows, (x.index_select(0, rows).float() + self._deltas[layer].float()).to(x.dtype))
+        self.partial_blocks += 1
+        return output
+
+    def record_subset_attention(self, rows: int) -> None:
+        if not self.partial or rows != self.global_dense_positions.numel():
+            raise RuntimeError("unexpected subset attention query count")
+        self.subset_attention_calls += 1
+        self.subset_query_rows += rows
+        self.omitted_query_rows += len(self._target_positions)
+
+    def end_step(self) -> None:
+        if self._blocks_this_step != self.num_layers:
+            raise RuntimeError("video-row cache step did not visit every main block")
+
+    def stats(self) -> dict[str, int | bool]:
+        return {
+            name: getattr(self, name)
+            for name in [
+                "full_steps",
+                "partial_steps",
+                "full_blocks",
+                "partial_blocks",
+                "subset_attention_calls",
+                "subset_query_rows",
+                "omitted_query_rows",
+                "partial_mlp_rows",
+                "cache_bytes",
+                "closed",
+            ]
+        }
+
+    def close(self) -> None:
+        self._deltas.clear()
+        self._target_positions.clear()
+        self.global_dense_positions = torch.empty(0, dtype=torch.long)
+        self.local_dense_positions = None
+        self.local_video_positions = None
+        self.closed = True
