+@pytest.mark.parametrize("start,length", [(0, 4), (1, 2)])
+def test_attention_keeps_collective_path_and_projects_only_dense_local_rows(start, length):
+    state = state_for_rows(start=start, length=length)
+    x = torch.ones(length, 2, dtype=torch.bfloat16)
+    anchor(state, x)
+    attention = object.__new__(blocks.MiniMaxH3Attention)
+    nn.Module.__init__(attention)
+    attention.num_heads = 1
+    attention.head_dim = 2
+    attention.vdn = None
+    attention.to_gate_compress = None
+    calls, projected_rows = [], []
+    attention._project_qkv = lambda *args: (x.reshape(length, 1, 2),) * 5
+
+    def packed(q, k, v, **kwargs):
+        calls.append(q.shape[0])
+        assert kwargs["video_row_cache"] is state
+        return q
+
+    def project(rows):
+        projected_rows.append(rows.shape[0])
+        return rows * 2, None
+
+    attention._run_packed_attention = packed
+    attention.out_proj = project
+    output = attention(
+        x,
+        rope_table=None,
+        cu_seqlens=torch.tensor([0, 3, 4], dtype=torch.int32),
+        max_seqlen=3,
+        packed_total=4,
+        video_row_cache=state,
+    )
+    rows = state.local_dense_positions
+    assert calls == [length]
+    assert projected_rows == ([rows.numel()] if rows.numel() else [])
+    assert torch.equal(output.index_select(0, rows), (x * 2).index_select(0, rows))
+    assert torch.count_nonzero(output.index_select(0, state.local_video_positions)) == 0
+
+
+def _native_worker(rank):
+    import torch_npu  # noqa: F401
+
+    torch.npu.set_device(rank)
+    dist.init_process_group(
+        "hccl", init_method="tcp://127.0.0.1:29597", rank=rank, world_size=4, timeout=timedelta(seconds=120)
+    )
+    try:
+        torch.manual_seed(19)
+        full = [torch.randn(32, 4, 128, dtype=torch.bfloat16).npu() for _ in range(3)]
+        exchanged = []
+        for tensor in full:
+            local = tensor[rank * 8 : (rank + 1) * 8]
+            send = local.reshape(8, 4, 1, 128).permute(1, 0, 2, 3).contiguous()
+            receive = torch.empty_like(send)
+            dist.all_to_all_single(receive, send)
+            exchanged.append(receive.reshape(1, 32, 1, 128))
+        state = MiniMaxH3VideoRowCache(torch.arange(8, 24, device="npu"), seq_len=32, used_len=30, num_layers=1)
+        state.prepare_local_span(rank * 8, 8)
+        x = torch.ones(8, 2, dtype=torch.bfloat16, device="npu")
+        anchor(state, x)
+        output = _subset_prefix_bnsd(exchanged[0], exchanged[1][:, :30], exchanged[2][:, :30], 128**-0.5, state)
+        send = output.reshape(4, 8, 1, 128).contiguous()
+        receive = torch.empty_like(send)
+        dist.all_to_all_single(receive, send)
+        local_output = receive.permute(1, 0, 2, 3).reshape(8, 4, 128)
+        expected = _prefix_bnsd(full[0].unsqueeze(0), full[1][:30].unsqueeze(0), full[2][:30].unsqueeze(0), 128**-0.5)[
+            0
+        ]
+        rows = state.local_dense_positions
+        torch.testing.assert_close(
+            local_output.index_select(0, rows).float(),
+            expected[rank * 8 : (rank + 1) * 8].index_select(0, rows).float(),
+            atol=0.03125,
+            rtol=0.02,
+        )
+        assert state.subset_attention_calls == 1 and state.subset_query_rows == 14
+        assert rows.numel() == [8, 0, 0, 6][rank]
+        state.restore(0, x)
+        state.end_step()
+        state.close()
+        torch.npu.synchronize()
+        dist.barrier()
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires four native Ascend devices")
+def test_native_four_rank_subset_attention_with_empty_local_dense_rows():
+    torch.multiprocessing.spawn(_native_worker, nprocs=4, join=True)
