+def _subset_prefix_bnsd(query, key, value, scale, state):
+    """Compute only fresh conditioning queries; preserve the shared SP shape."""
+    rows = state.global_dense_positions
+    dense = _prefix_bnsd(query.index_select(1, rows), key, value, scale)
+    output = torch.zeros_like(query)
+    output.index_copy_(1, rows, dense)
+    state.record_subset_attention(rows.numel())
+    return output
