+class CountMLP(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.rows = []
+
+    def forward(self, x):
+        self.rows.append(x.shape[0])
+        return x + 0.25
+
+
+def tiny_block():
+    block = object.__new__(blocks.MiniMaxH3DiTBlock)
+    nn.Module.__init__(block)
+    block.layer_index = 0
+    block.norm1 = SimpleNamespace(weight=torch.ones(2), variance_epsilon=1e-6)
+    block.norm2 = SimpleNamespace(weight=torch.ones(2), variance_epsilon=1e-6)
+    block.adaln_proj = lambda t: (
+        torch.zeros(3, 2),
+        torch.zeros(3, 2),
+        torch.ones(3, 2),
+        torch.zeros(3, 2),
+        torch.zeros(3, 2),
+        torch.ones(3, 2),
+    )
+    block.attn = lambda x, **kwargs: x * 0.5
+    block.mlp = CountMLP()
+    return block
+
