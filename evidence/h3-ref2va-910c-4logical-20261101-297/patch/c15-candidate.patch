+def state_for_rows(device="cpu", start=0, length=4):
+    state = MiniMaxH3VideoRowCache(torch.tensor([1, 2], device=device), seq_len=4, used_len=3, num_layers=1)
+    state.prepare_local_span(start, length)
+    return state
+
+
+def anchor(state, x):
+    for step in range(5):
+        state.begin_step(step)
+        state.capture(0, x, x + 0.125)
+        state.end_step()
+    state.begin_step(5)
+
+
+def test_fixed_schedule_and_row_ownership_excludes_padding():
+    assert [i for i in range(50) if MiniMaxH3VideoRowCache.is_full_step(i)] == [
+        0,
+        1,
+        2,
+        3,
+        4,
+        9,
+        14,
+        19,
+        24,
+        29,
+        34,
+        39,
+        44,
+        46,
+        47,
+        48,
+        49,
+    ]
+    state = state_for_rows()
+    assert state.global_dense_positions.tolist() == [0]
+    assert state.local_dense_positions.tolist() == [0]
+    assert state.local_video_positions.tolist() == [1, 2]
+    with pytest.raises(RuntimeError, match="ownership"):
+        state.prepare_local_span(0, 3)
+
