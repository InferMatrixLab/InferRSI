+@pytest.mark.parametrize("ref2va", [False, True])
+def test_real_packing_task_selects_ref2va_and_rejects_fl2va(monkeypatch, ref2va):
+    from vllm_omni.diffusion.models.minimax_h3 import denoise_loop as loop
+    from vllm_omni.diffusion.models.minimax_h3.packed_sequence import (
+        minimax_h3_packed_sequence,
+        minimax_h3_packed_sequence_ref2va_blocks,
+    )
+
+    common = dict(text_len=2, latent_t=2, latent_h=4, latent_w=4, audio_t=2)
+    packed = (
+        minimax_h3_packed_sequence_ref2va_blocks(**common, ref_blocks=[{"kind": "image", "latent_h": 4, "latent_w": 4}])
+        if ref2va
+        else minimax_h3_packed_sequence(**common, include_keyframe_cond=True, keyframe_frame_indices=[0], frame_count=5)
+    )
+    branch = loop.MiniMaxH3DenoiseBranch(
+        packed=packed,
+        text_embeddings=torch.zeros(2, 5120),
+        token_tags=packed["token_tags"],
+        device=torch.device("cpu"),
+        task="ref2va" if ref2va else "fl2va",
+    )
+    layout = branch.static_kwargs["video_token_layout"]
+    assert not any(span.role == "reference" for span in layout.video_spans)
+    monkeypatch.setenv("H3_VIDEO_ROW_CACHE", "1")
+    monkeypatch.setattr(loop.current_omni_platform, "is_npu", lambda: False)
+    monkeypatch.setattr(loop, "minimax_h3_publish_denoise_progress", lambda *args: None)
+    monkeypatch.setattr(loop, "check_request_cancellation", lambda **kwargs: None)
+    states = []
+
+    class Model:
+        def create_video_row_cache(self, positions, **kwargs):
+            state = MiniMaxH3VideoRowCache(
+                positions, seq_len=kwargs["seq_len"], used_len=kwargs["used_len"], num_layers=1
+            )
+            state.prepare_local_span(0, branch.seq_len)
+            states.append(state)
+            return state
+
+        def __call__(self, **kwargs):
+            state = kwargs["video_row_cache"]
+            x = torch.ones(branch.seq_len, 2, dtype=torch.bfloat16)
+            if state.partial:
+                state.restore(0, x)
+            else:
+                state.capture(0, x, x + 0.125)
+            return torch.zeros(branch.img_pos.numel(), 96), torch.zeros(branch.audio_pos.numel(), 32)
+
+    kwargs = dict(
+        model=Model(),
+        positive=branch,
+        initial_video_rows=torch.zeros(branch.img_pos.numel(), 96),
+        initial_audio_rows=torch.zeros(branch.audio_pos.numel(), 32),
+        keyframe_cond_rows=torch.zeros(int((~branch.update_mask).sum()), 96),
+        sigmas_video=[1 - i / 50 for i in range(51)],
+        sigmas_audio=[1 - i / 50 for i in range(51)],
+        device=torch.device("cpu"),
+    )
+    if ref2va:
+        loop.minimax_h3_denoise_loop(**kwargs)
+        assert len(states) == 1 and states[0].closed
+        assert states[0].full_steps == 17 and states[0].partial_steps == 33
+    else:
+        with pytest.raises(ValueError, match="requires Ref2VA"):
+            loop.minimax_h3_denoise_loop(**kwargs)
+        assert not states
+
