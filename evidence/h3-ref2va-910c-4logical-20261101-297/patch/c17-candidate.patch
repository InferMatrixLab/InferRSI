+def _video_temporal_window_bnsd(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    scale: float,
+    *,
+    target_start: int,
+    frames: int,
+    rows_per_frame: int,
+) -> torch.Tensor:
+    """Fresh global-prefix queries and local video queries, in original row order."""
+    if (
+        query.shape[0] != 1
+        or key.shape[0] != 1
+        or value.shape != key.shape
+        or query.shape[2:] != key.shape[2:]
+        or target_start < 0
+        or frames < 3
+        or rows_per_frame < 1
+        or target_start + frames * rows_per_frame != key.shape[1]
+        or query.shape[1] < key.shape[1]
+    ):
+        raise ValueError("H3 temporal window requires one final contiguous target-video span and a valid KV prefix")
+    heads, dim = query.shape[2:]
+    starts = (torch.arange(frames, device=key.device) - 1).clamp(0, frames - 3)
+
+    def pack_windows(tensor: torch.Tensor) -> torch.Tensor:
+        video = tensor[:, target_start:].reshape(frames, rows_per_frame, heads, dim)
+        windows = video.unfold(0, 3, 1).permute(0, 4, 1, 2, 3).reshape(frames - 2, 3 * rows_per_frame, heads, dim)
+        selected = windows.index_select(0, starts)
+        prefix = tensor[:, :target_start].expand(frames, -1, -1, -1)
+        return torch.cat((prefix, selected), dim=1)
+
+    output = torch.zeros_like(query)
+    if target_start:
+        output[:, :target_start] = _prefix_bnsd(query[:, :target_start], key, value, scale)
+    video_query = query[:, target_start : key.shape[1]].reshape(frames, rows_per_frame, heads, dim)
+    video_output = _prefix_bnsd(video_query, pack_windows(key), pack_windows(value), scale)
+    output[:, target_start : key.shape[1]] = video_output.reshape(1, frames * rows_per_frame, heads, dim)
+    return output
+
+
+def _use_video_temporal_window() -> bool:
+    if os.environ.get("H3_VIDEO_TEMPORAL_WINDOW") != "3":
+        raise ValueError("The experimental H3 temporal-window profile requires window=3")
+    context = get_forward_context()
+    step, total = context.denoise_step_idx, context.total_denoise_steps
+    if total != 50 or step is None or not 0 <= step < 50:
+        raise ValueError("The experimental H3 temporal-window profile requires published 50-step progress")
+    return step not in (0, 49)
+
