+def reference(query, key, value, scale):
+    q, k, v = [tensor.transpose(1, 2).float() for tensor in (query, key, value)]
+    return (torch.softmax(q @ k.transpose(-2, -1) * scale, dim=-1) @ v).transpose(1, 2).to(query.dtype)
+
+
+def fixture(frames=5, prefix=4, rows=3, padding=2, heads=2, dim=8, device="cpu"):
+    torch.manual_seed(19)
+    used = prefix + frames * rows
+    q = torch.randn(1, used + padding, heads, dim, dtype=torch.bfloat16).to(device)
+    k, v = [torch.randn(1, used, heads, dim, dtype=torch.bfloat16).to(device) for _ in range(2)]
+    return q, k, v
+
+
+@pytest.mark.parametrize("frames,prefix", [(3, 0), (3, 4), (5, 4), (7, 2)])
+def test_window_matches_explicit_per_frame_key_sets(monkeypatch, frames, prefix):
+    q, k, v = fixture(frames=frames, prefix=prefix)
+    before = [tensor.clone() for tensor in (q, k, v)]
+    calls = []
+
+    def primitive(query, key, value, scale):
+        calls.append((query.shape, key.shape))
+        return reference(query, key, value, scale)
+
+    monkeypatch.setattr(flash, "_prefix_bnsd", primitive)
+    actual = flash._video_temporal_window_bnsd(q, k, v, 0.25, target_start=prefix, frames=frames, rows_per_frame=3)
+    if prefix:
+        torch.testing.assert_close(actual[:, :prefix], reference(q[:, :prefix], k, v, 0.25), rtol=0, atol=0)
+    for t in range(frames):
+        start = min(max(t - 1, 0), frames - 3)
+        keys = torch.cat((k[:, :prefix], k[:, prefix + start * 3 : prefix + (start + 3) * 3]), dim=1)
+        values = torch.cat((v[:, :prefix], v[:, prefix + start * 3 : prefix + (start + 3) * 3]), dim=1)
+        expected = reference(q[:, prefix + t * 3 : prefix + (t + 1) * 3], keys, values, 0.25)
+        torch.testing.assert_close(actual[:, prefix + t * 3 : prefix + (t + 1) * 3], expected, rtol=0, atol=0)
+    assert torch.count_nonzero(actual[:, k.shape[1] :]) == 0
+    assert all(torch.equal(a, b) for a, b in zip(before, (q, k, v)))
+    assert len(calls) == (2 if prefix else 1)
+    assert calls[-1][0] == (frames, 3, 2, 8)
+    assert calls[-1][1] == (frames, prefix + 9, 2, 8)
+
+
+@pytest.mark.parametrize("kind", ["short", "tail", "batch", "query"])
+def test_requested_unsupported_geometry_raises(kind):
+    q, k, v = fixture()
+    kwargs = dict(target_start=4, frames=5, rows_per_frame=3)
+    if kind == "short":
+        kwargs["frames"] = 2
+    elif kind == "tail":
+        kwargs["target_start"] = 3
+    elif kind == "batch":
+        q, k, v = [tensor.expand(2, -1, -1, -1) for tensor in (q, k, v)]
+    else:
+        q = q[:, :2]
+    with pytest.raises(ValueError, match="temporal window"):
+        flash._video_temporal_window_bnsd(q, k, v, 0.25, **kwargs)
+
+
+def test_fixed_step_profile_and_invalid_progress(monkeypatch):
+    monkeypatch.setenv("H3_VIDEO_TEMPORAL_WINDOW", "3")
+    for step in range(50):
+        monkeypatch.setattr(
+            flash, "get_forward_context", lambda: SimpleNamespace(denoise_step_idx=step, total_denoise_steps=50)
+        )
+        assert flash._use_video_temporal_window() == (step not in (0, 49))
+    monkeypatch.setattr(
+        flash, "get_forward_context", lambda: SimpleNamespace(denoise_step_idx=None, total_denoise_steps=50)
+    )
+    with pytest.raises(ValueError, match="published"):
+        flash._use_video_temporal_window()
+    monkeypatch.setenv("H3_VIDEO_TEMPORAL_WINDOW", "5")
+    with pytest.raises(ValueError, match="window=3"):
+        flash._use_video_temporal_window()
+
