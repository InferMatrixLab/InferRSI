+def test_default_long_prefix_path_does_not_read_window_progress(monkeypatch):
+    from vllm_omni.diffusion.attention.backends.abstract import AttentionMetadata
+
+    monkeypatch.setenv("MINDIE_SD_FA_TYPE", "fused_attn_score")
+    monkeypatch.delenv("H3_VIDEO_TEMPORAL_WINDOW", raising=False)
+    impl = object.__new__(flash.MiniMaxH3FlashAttentionImpl)
+    impl.causal, impl.softmax_scale = False, 0.25
+    impl._resolve_packed_seq_npu = lambda *args: ([4096], [4093])
+    monkeypatch.setattr(flash, "get_forward_context", lambda: pytest.fail("default path read window progress"))
+    calls = []
+    monkeypatch.setattr(flash, "_prefix_bnsd", lambda q, k, v, scale: calls.append(k.shape[1]) or q)
+    q = torch.ones(1, 4096, 1, 8, dtype=torch.bfloat16)
+    metadata = AttentionMetadata(extra={"npu_attn_varlen": True})
+    assert impl.forward_fa_npu(q, q, q, metadata) is q
+    assert calls == [4093]
+
+
+@pytest.mark.parametrize("step", [0, 1, 49])
+def test_configured_long_path_routes_published_geometry(monkeypatch, step):
+    from vllm_omni.diffusion.attention.backends.abstract import AttentionMetadata, VideoTokenLayout, VideoTokenSpan
+
+    monkeypatch.setenv("MINDIE_SD_FA_TYPE", "fused_attn_score")
+    monkeypatch.setenv("H3_VIDEO_TEMPORAL_WINDOW", "3")
+    monkeypatch.setattr(
+        flash, "get_forward_context", lambda: SimpleNamespace(denoise_step_idx=step, total_denoise_steps=50)
+    )
+    impl = object.__new__(flash.MiniMaxH3FlashAttentionImpl)
+    impl.causal, impl.softmax_scale = False, 0.25
+    impl._resolve_packed_seq_npu = lambda *args: ([4160], [4160])
+    q = torch.ones(1, 4192, 1, 8, dtype=torch.bfloat16)
+    layout = VideoTokenLayout(
+        used_len=4160, video_spans=(VideoTokenSpan(start=64, latent_grid=(4, 32, 32), role="target"),)
+    )
+    metadata = AttentionMetadata(extra={"npu_attn_varlen": True}, video_layout=layout)
+    calls = []
+    monkeypatch.setattr(flash, "_prefix_bnsd", lambda *args: calls.append("dense") or q)
+
+    def window(query, key, value, scale, **kwargs):
+        assert key.shape[1] == value.shape[1] == 4160
+        assert kwargs == {"target_start": 64, "frames": 4, "rows_per_frame": 1024}
+        calls.append("window")
+        return q
+
+    monkeypatch.setattr(flash, "_video_temporal_window_bnsd", window)
+    assert impl.forward_fa_npu(q, q, q, metadata) is q
+    assert calls == (["dense"] if step in (0, 49) else ["window"])
+
+
+@pytest.mark.skipif(not current_omni_platform.is_npu(), reason="Requires native Ascend FAS")
+def test_native_bf16_window_fas_executes_real_batched_geometry():
+    import torch_npu  # noqa: F401
+
+    q, k, v = fixture(rows=8, heads=14, dim=128, device="npu")
+    output = flash._video_temporal_window_bnsd(q, k, v, 128**-0.5, target_start=4, frames=5, rows_per_frame=8)
+    torch.npu.synchronize()
+    assert output.dtype == torch.bfloat16 and torch.isfinite(output).all()
+    for t in range(5):
+        start = min(max(t - 1, 0), 2)
+        keys = torch.cat((k[:, :4], k[:, 4 + start * 8 : 4 + (start + 3) * 8]), dim=1)
+        values = torch.cat((v[:, :4], v[:, 4 + start * 8 : 4 + (start + 3) * 8]), dim=1)
+        expected = reference(q[:, 4 + t * 8 : 4 + (t + 1) * 8].cpu(), keys.cpu(), values.cpu(), 128**-0.5)
+        torch.testing.assert_close(
+            output[:, 4 + t * 8 : 4 + (t + 1) * 8].cpu().float(), expected.float(), atol=0.03125, rtol=0.02
+        )
+
