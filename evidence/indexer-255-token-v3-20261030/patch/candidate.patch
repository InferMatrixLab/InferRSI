diff --git a/tests/test_collect_token_selection.py b/tests/test_collect_token_selection.py
new file mode 100644
index 00000000..41a3317e
--- /dev/null
+++ b/tests/test_collect_token_selection.py
@@ -0,0 +1,78 @@
+import json
+from pathlib import Path
+
+import pytest
+
+from inferrsi._skill_selection import token_score
+from inferrsi.knowledge_operations import KnowledgeReader
+
+CASES = json.loads((Path(__file__).parent / 'fixtures/indexer/accuracy-token-v3/synthetic.json')
+                   .read_text())['cases']
+
+
+@pytest.mark.parametrize('case', CASES, ids=lambda case: case['id'])
+def test_frozen_token_contract(case):
+    assert token_score(case['cue'], case['fields']) == case['expected_whole_token_score']
+
+
+def test_default_and_explicit_default_identical():
+    reader = KnowledgeReader()
+    for options in ({}, {'relevance': 'candidate', 'context_bytes': 262144}):
+        assert reader.collect(**options) == reader.collect(
+            **options, relevance_method='weighted-lexical-v1')
+
+
+def test_opt_in_validation():
+    reader = KnowledgeReader()
+    with pytest.raises(ValueError, match='requires a relevance'):
+        reader.collect(relevance_method='weighted-token-v3')
+    with pytest.raises(ValueError, match='Unknown relevance'):
+        reader.collect(relevance='gpu', relevance_method='unknown')
+
+
+def test_explicit_selection_resources_and_budget_unchanged():
+    reader = KnowledgeReader()
+    identity = 'inferrsi.common.skills.cgroup_resource_controls'
+    revision = reader.read(identity).revision
+    for budget in (1, 262144):
+        options = dict(ids=[identity], revisions={identity: revision}, relevance='ram',
+                       context_bytes=budget)
+        legacy = reader.collect(**options)
+        token = reader.collect(**options, relevance_method='weighted-token-v3')
+        assert token['selection']['ranking_applied'] is False
+        token['selection']['method'] = legacy['selection']['method']
+        assert token == legacy
+
+
+def test_token_operational_controls_and_substring_query():
+    reader = KnowledgeReader()
+    options = dict(relevance_method='weighted-token-v3')
+    assert reader.collect(relevance='zzzznonexistent255token', **options)['no_match']
+    assert reader.collect(relevance='cgroupv2', repo='not-a-real-repo', **options)['no_match']
+    result = reader.collect('stat.loc', relevance='cgroupv2', **options)
+    assert result['items'][0]['id'] == 'inferrsi.common.skills.cgroup_resource_controls'
+    assert reader.collect('stat.loc zzzznonexistent255token', relevance='cgroupv2',
+                          **options)['no_match']
+
+
+def test_token_ties_use_qualified_identity_order():
+    from inferrsi._skill_selection import skill_score
+    reader = KnowledgeReader()
+    result = reader.collect(relevance='candidate', relevance_method='weighted-token-v3', limit=100)
+    ordered = []
+    for item in result['items']:
+        bundle = reader.read(item['ref'])
+        record = reader.records()[item['id']]
+        core = record['skill_documents']['original']
+        ordered.append((-skill_score('candidate', record, bundle.content[core],
+                                    method='weighted-token-v3'), item['ref']))
+    assert ordered == sorted(ordered)
+
+
+def test_cli_token_method(capsys):
+    from inferrsi.cli import main
+    assert main(['collect', '', '--relevance', 'cgroupv2', '--relevance-method',
+                 'weighted-token-v3', '--json']) == 0
+    result = json.loads(capsys.readouterr().out)
+    assert result['selection']['method'] == 'weighted-token-v3'
+    assert result['items'][0]['id'] == 'inferrsi.common.skills.cgroup_resource_controls'
