+def string_value_words(value: object) -> set[str]:
+    """Union tokens from scalar string values, never keys or serialized syntax."""
+    if isinstance(value, str):
+        return words(value)
+    if isinstance(value, dict):
+        values = value.values()
+    elif isinstance(value, (list, tuple)):
+        values = value
+    else:
+        return set()
+    tokens: set[str] = set()
+    for item in values:
+        tokens.update(string_value_words(item))
+    return tokens
+
+
+def token_score(cue: str, fields: list[tuple[int, object]]) -> int:
+    """Experimental string-value token presence; no morphology or key evidence."""
+    tokens = words(cue)
+    return sum(weight * len(tokens & string_value_words(value)) for weight, value in fields)
+
