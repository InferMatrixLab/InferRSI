+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+import pytest
+import torch
+
+from tests.model_executor.models.minicpmo_4_5.test_code2wav_batching import _FakeToken2Wav
+from vllm_omni.model_executor.models.minicpmo_4_5.batched_token2wav import BatchedToken2Wav
+
+pytestmark = [pytest.mark.core_model, pytest.mark.cpu]
+
+
+@pytest.mark.parametrize("cache_size", [0, 1, 4])
+def test_prompt_batch_preserves_cfg_rows_duplicates_and_cache_ownership(cache_size):
+    token2wav = _FakeToken2Wav()
+    backend = BatchedToken2Wav(token2wav, setup_cache_size=cache_size)
+    prompts = [backend.prepare_prompt(str(i), f"/fake/{i}.wav") for i in range(3)]
+    for i, prompt in enumerate(prompts):
+        prompt.speech_tokens.add_(i * 10)
+    expected = [backend._create_initial_states(prompt, 1)[0] for prompt in prompts]
+    token2wav.flow.decoder.estimator.cfg_batches.clear()
+    actual = backend.setup_many([prompts[2], prompts[0], prompts[2], prompts[1]])
+    assert actual[0] is actual[2]
+    assert token2wav.flow.decoder.estimator.cfg_batches == [6, 6]
+    for state, reference in zip(actual, [expected[2], expected[0], expected[2], expected[1]], strict=True):
+        for key in reference.flow_cache:
+            torch.testing.assert_close(state.flow_cache[key], reference.flow_cache[key], rtol=0, atol=0)
+    snapshot = actual[1].flow_cache["estimator_att_cache"].clone()
+    actual[0].flow_cache["estimator_att_cache"].add_(1)
+    torch.testing.assert_close(actual[1].flow_cache["estimator_att_cache"], snapshot, rtol=0, atol=0)
+    assert len(backend._setup_cache) <= cache_size
+
+
+def test_prompt_batch_reuses_existing_cached_state():
+    backend = BatchedToken2Wav(_FakeToken2Wav(), setup_cache_size=2)
+    first = backend.prepare_prompt("first", "/fake/first.wav")
+    second = backend.prepare_prompt("second", "/fake/second.wav")
+    cached = backend.setup_batch(first, 1)[0]
+    result = backend.setup_many([first, second, first])
+    assert result[0] is result[2] is cached
+    assert backend.setup_many([]) == []
