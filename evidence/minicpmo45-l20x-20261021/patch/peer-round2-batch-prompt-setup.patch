+    def _create_initial_states_many(self, features: list[PromptFeatures]) -> list[BatchedToken2WavState]:
+        """Share one Euler solve across equal-length, independently encoded prompts."""
+        if len(features) == 1:
+            return self._create_initial_states(features[0], 1)
+        encoded, speakers, mels, cnn, att = [], [], [], [], []
+        with self._autocast(features[0].speaker_embedding.device):
+            for prompt in features:
+                tokens, speaker, mel = self._repeat_prompt(prompt, 1)
+                lookahead_width = self._pre_lookahead_len()
+                lookahead = tokens.new_full((1, 3 if lookahead_width is None else lookahead_width), _SILENCE_TOKEN)
+                hidden, row_cnn, row_att = self._encode_chunk(
+                    torch.cat((tokens, lookahead), dim=1), last_chunk=False, cnn_cache=None, att_cache=None
+                )
+                encoded.append(hidden)
+                speakers.append(self._project_speakers(speaker))
+                mels.append(mel)
+                cnn.append(row_cnn)
+                att.append(row_att)
+            prompt_mels = torch.cat(mels, dim=0)
+            _, estimator_cnn, estimator_att = self._decode_cfm(
+                torch.cat(encoded, dim=0).transpose(1, 2).contiguous(),
+                torch.cat(speakers, dim=0),
+                prompt_mels.transpose(1, 2).contiguous(),
+                cnn_cache=None,
+                att_cache=None,
+                att_keep=(int(prompt_mels.shape[1]), _CACHE_TRIM_SUFFIX),
+            )
+        rows = self._split_flow_cache(
+            {
+                "conformer_cnn_cache": torch.cat(cnn, dim=0),
+                "conformer_att_cache": torch.cat(att, dim=1),
+                "estimator_cnn_cache": estimator_cnn,
+                "estimator_att_cache": estimator_att,
+            },
+            len(features),
+        )
+        return [
+            BatchedToken2WavState(
+                flow_cache=row,
+                hift_cache={
+                    "mel": prompt_mels.new_zeros((1, int(prompt_mels.shape[2]), 0)),
+                    "source": prompt_mels.new_zeros((1, 1, 0)),
+                    "speech": prompt_mels.new_zeros((1, 0)),
+                },
+            )
+            for row in rows
+        ]
+
+    def setup_many(self, features: list[PromptFeatures]) -> list[BatchedToken2WavState]:
+        """Reuse cached states and batch equal-length misses, preserving caller order."""
+        keys = [self._setup_cache_key(prompt) for prompt in features]
+        states: dict[tuple[tuple[str, str], int], BatchedToken2WavState] = {}
+        missing: dict[tuple[tuple[str, str], int], PromptFeatures] = {}
+        for key, prompt in zip(keys, features, strict=True):
+            if key in self._setup_cache:
+                states[key] = self._setup_cache[key]
+                self._setup_cache.move_to_end(key)
+            else:
+                missing.setdefault(key, prompt)
+        groups: dict[tuple[int, int], list[PromptFeatures]] = {}
+        for prompt in missing.values():
+            shape = (int(prompt.speech_tokens.shape[1]), int(prompt.mels.shape[1]))
+            groups.setdefault(shape, []).append(prompt)
+        for prompts in groups.values():
+            for prompt, state in zip(prompts, self._create_initial_states_many(prompts), strict=True):
+                key = self._setup_cache_key(prompt)
+                states[key] = state
+                if self._setup_cache_size > 0:
+                    self._setup_cache[key] = state
+                    while len(self._setup_cache) > self._setup_cache_size:
+                        self._setup_cache.popitem(last=False)
+        return [states[key] for key in keys]
