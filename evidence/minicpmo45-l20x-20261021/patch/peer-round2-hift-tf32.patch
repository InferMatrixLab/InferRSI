+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+
+import pytest
+import torch
+
+from vllm_omni.model_executor.models.cosyvoice3.code2wav_core.hifigan import _upsample_tf32
+
+pytestmark = [pytest.mark.core_model, pytest.mark.cpu]
+
+
+@pytest.mark.parametrize("enabled", [False, True])
+@pytest.mark.parametrize("initial", [False, True])
+@pytest.mark.parametrize("raise_error", [False, True])
+def test_upsample_policy_restores_after_call(enabled, initial, raise_error):
+    old = (torch.backends.cudnn.allow_tf32, torch.backends.cuda.matmul.allow_tf32)
+    try:
+        torch.backends.cudnn.allow_tf32 = initial
+        torch.backends.cuda.matmul.allow_tf32 = not initial
+        try:
+            with _upsample_tf32(enabled):
+                assert torch.backends.cudnn.allow_tf32 == (True if enabled else initial)
+                assert torch.backends.cuda.matmul.allow_tf32 == (True if enabled else not initial)
+                if raise_error:
+                    raise RuntimeError("decoder failure")
+        except RuntimeError as exc:
+            assert str(exc) == "decoder failure"
+        assert torch.backends.cudnn.allow_tf32 == initial
+        assert torch.backends.cuda.matmul.allow_tf32 == (not initial)
+    finally:
+        torch.backends.cudnn.allow_tf32, torch.backends.cuda.matmul.allow_tf32 = old
