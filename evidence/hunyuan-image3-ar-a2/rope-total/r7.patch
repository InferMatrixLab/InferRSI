+        rotated = qk * cos + torch.cat((right, left), dim=-1) * signed_sin
+        q, k = rotated.flatten(1).split((q_size, kv_size), dim=-1)
+        return q.contiguous(), k.contiguous(), qkv[..., q_size + kv_size :]
 
