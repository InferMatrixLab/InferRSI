+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+"""Rotate the packed HunyuanImage query/key prefix into two contiguous outputs."""
+from functools import lru_cache
+
+import torch
+from vllm.triton_utils import HAS_TRITON, tl, triton
+
+
+@lru_cache(maxsize=None)
+def supports_device(device):
+    return HAS_TRITON and "910B" in torch.npu.get_device_name(device)
+
+
+@triton.jit
+def _packed_rotary(src, cos, signed_sin, q, k, tokens, QH: tl.constexpr,
+                   KH: tl.constexpr, DIM: tl.constexpr, ROWS: tl.constexpr):
+    block = tl.program_id(0)
+    head = block % (QH + KH)
+    row = (block // (QH + KH)) * ROWS + tl.arange(0, ROWS)
+    col = tl.arange(0, DIM)
+    mask = row[:, None] < tokens
+    src_row = row[:, None] * ((QH + 2 * KH) * DIM) + head * DIM
+    factor_row = row[:, None] * DIM + col[None, :]
+    x = tl.load(src + src_row + col[None, :], mask, other=0)
+    other_col = (col + DIM // 2) % DIM
+    y = tl.load(src + src_row + other_col[None, :], mask, other=0)
+    c = tl.load(cos + factor_row, mask, other=0).to(tl.float32)
+    s = tl.load(signed_sin + factor_row, mask, other=0).to(tl.float32)
+    # The eager bf16 multiplications round independently before addition.
+    first = (x.to(tl.float32) * c).to(x.dtype).to(tl.float32)
+    second = (y.to(tl.float32) * s).to(y.dtype).to(tl.float32)
+    value = (first + second).to(x.dtype)
+    if head < QH:
+        dest = row[:, None] * (QH * DIM) + head * DIM + col[None, :]
+        tl.store(q + dest, value, mask)
+    else:
+        dest = row[:, None] * (KH * DIM) + (head - QH) * DIM + col[None, :]
+        tl.store(k + dest, value, mask)
+
+
+def rotate(qkv, cos, signed_sin, q_size, kv_size, dim):
+    n = qkv.shape[0]
+    q = qkv.new_empty((n, q_size))
+    k = qkv.new_empty((n, kv_size))
+    qh, kh = q_size // dim, kv_size // dim
+    rows = 1 if n <= 16 else 16
+    grid = (triton.cdiv(n, rows) * (qh + kh),)
+    _packed_rotary[grid](qkv, cos, signed_sin, q, k, n, qh, kh, dim, rows, enable_fp_fusion=False)
+    return q, k, qkv[..., q_size + kv_size :]
