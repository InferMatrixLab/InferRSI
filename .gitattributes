* text=auto eol=lf
.git_archival.txt export-subst

# Preserve recorded evidence and historical validator bytes across checkouts.
/evidence/** -text
/tests/fixtures/legacy/** -text
/tests/fixtures/atomic-reader/** -text whitespace=-blank-at-eof
# A session started by an older runtime keeps its exact bytes; its plan pins file hashes.
/tests/fixtures/optimization-session/pre-infra-removal-session/** -text
/tests/fixtures/optimization-session/pre-trials-rename-session/** -text
/tests/fixtures/optimization-session/pre-recovery-closure-session/** -text whitespace=cr-at-eol
# Reusable guidance is editable text, not a frozen evidence bundle.
/evidence/README.md text eol=lf
/evidence/_template/** text eol=lf

# Case atoms address byte ranges in the original release files.
/src/inferrsi/knowledge/atoms/casebooks/* -text

# Retain this upstream license's original CRLF Git blob bytes.
/src/inferrsi/knowledge/data/skill_library/systems/frameworks/torch-npu/torch-npu/references/licenses/op-plugin-LICENSE.txt -text

# Source-backed Record atoms pin byte ranges in the original release files.
/src/inferrsi/knowledge/atoms/records/*.json -text

# Generated third-party bundles, with source references and notices beside them.
/plugins/inferrsi-dsh/vendor/ssh2.cjs linguist-generated=true linguist-vendored=true
/plugins/inferrsi-dsh/vendor/yaml.cjs linguist-generated=true linguist-vendored=true
