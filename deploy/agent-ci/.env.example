# Copy to .env outside the source checkout and select a reviewed upstream release.
# Credentials are entered through the instance's administration UI, never here.
BOT_IMAGE_TAG=<bot-release>
BOT_WEBHOOK_PORT=8791
BOT_ADMIN_PORT=8792
BOT_COOKIE_SECURE=false
BOT_PROJECT_EGRESS=true
BOT_MENTION_NAMES=bot
